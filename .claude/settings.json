{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run ci)",
      "Bash(npm run check:conventions)",
      "Bash(npm run test:coverage)",
      "Bash(npm run test:integration)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/commit-hook.mjs\" --run",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
