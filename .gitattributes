# The sources of the catalog keep the line feed a string written across
# lines reads, whatever line endings a checkout writes.
*.qlang text eol=lf

# The entry of the playground keeps the line feed an install writes into
# its first line, so the worktree a run of the research installs stays as
# its commit holds it [QSRVW#readers].
playground/src/bin.mjs text eol=lf
