node_modules/
coverage/
gen/
# vitest writes a reporter payload here when one is asked for on the
# command line; it is a run artifact, not a checked-in fixture.
.vitest/
.claude/settings.local.json
.claude/*.lock

# npm workspaces — only the root package-lock.json is authoritative
# under the workspaces layout; per-workspace lockfiles drift stale and
# are ignored here so they do not get re-committed by accident.
core/package-lock.json
lsp/package-lock.json
site/package-lock.json
vscode/package-lock.json
