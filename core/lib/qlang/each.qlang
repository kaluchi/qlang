|~ `::each`, the kind of a map in a shape whose values share one shape,
   and the laws declared under it.
   The rules it holds: [QSDSP#residence], [QSPTH#shape]. ~|

:each
  |~~ An each stands in a shape for a map whose values are not all null,
      every key of which is data, an id, a date, a uuid or an email, or
      which holds more than eight names whose values, containers, values
      under a tag or null, share one shape, over its least key and the
      shape of its values: `{:"42" {:id 2} :"17" {:id 1}} | shape` answers
      `::shape::each{:"17" {:id ::number}}`.
      ::link~(::shape | doc)
  ~~|
  ::kind
    | wraps
        |~~ The least key of the map and the shape its values share. ~~|
        ::map
    | proves :foldsAMapKeyedByData
        |~~ A map keyed by data folds over its least key. ~~|
        ~({:"42" {:id 2} :"17" {:id 1}} | shape | eq ::shape::each{:"17" {:id ::number}})
    | proves :foldsAtomsKeyedByData
        |~~ A map keyed by data folds over atoms as well. ~~|
        ~({:"2024-01-01" 3 :"2024-01-02" 5} | shape | eq ::shape::each{:"2024-01-01" ::number})
    | proves :readsByTheKeyItShows
        |~~ A fold reads by the key it shows. ~~|
        ~({:"17" {:id 1} :"42" {:id 2}} | shape | get /17/id | eq ::number)
    | proves :keepsAFewNamesAsARecord
        |~~ A map of a few names keeps them, the fields `get` reads. ~~|
        ~({:db {:host "h"} :cache {:host "c"}} | shape | eq ::shape{:db {:host ::string} :cache {:host ::string}})
    | proves :foldsManyNamesOfOneShape
        |~~ A map of more than eight names of one shape folds. ~~|
        ~({:a {:n 1} :b {:n 2} :c {:n 3} :d {:n 4} :e {:n 5} :f {:n 6} :g {:n 7} :h {:n 8} :i {:n 9}} | shape | eq ::shape::each{:a {:n ::number}})
    | proves :keepsTheFieldsOfAMapOfAtoms
        |~~ A map of names over atoms keeps its keys. ~~|
        ~({:x 1 :y 2} | shape | eq ::shape{:x ::number :y ::number})
    | proves :keepsManyNamesWhoseValuesPart
        |~~ A map of many names whose values part keeps its keys. ~~|
        ~({:a 1 :b "x" :c 3 :d 4 :e 5 :f 6 :g 7 :h 8 :i 9} | shape | get /b | eq ::string)
    | proves :foldsDataKeysWhoseValuesPart
        |~~ A map keyed by data folds though its values part. ~~|
        ~({:"1" {:id 1} :"2" [1]} | shape | eq ::shape::each{:"1" #[{:id ::number} [::number]]})
    | proves :keepsTheKeysOfAMapOfNullAlone
        |~~ A map whose values are all null keeps its keys. ~~|
        ~({:"1" null :"2" null} | shape | eq ::shape{:"1" ::null :"2" ::null})
    | proves :keepsManyFieldsOverAtoms
        |~~ A map of names over atoms keeps them however many. ~~|
        ~({:a 1 :b 2 :c 3 :d 4 :e 5 :f 6 :g 7 :h 8 :i 9} | shape | keys | count | eq 9)
    | proves :keepsAKeyThatReadsAsNoNameAmongFields
        |~~ A key that reads as no name stays a field among names. ~~|
        ~({:"@type" "Person" :name "Ann"} | shape | eq ::shape{:"@type" ::string :name ::string})
    | proves :keepsTheKeyOfAMapOfOne
        |~~ A map of one name keeps it. ~~|
        ~({:users [1]} | shape | eq ::shape{:users [::number]})
