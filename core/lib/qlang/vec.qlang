|~ The verbs of vectors [D62]. Each resides on `::qlang/vec`, the kind
   whose module declares it, under the contract of its name on
   `::qlang/any`, whose page and laws it answers [D72]; a quote reads as
   the vector of its steps. The head of each is its declaration, which
   the runtime executes before the primitive runs. ~|

:count
  |~~ The number of elements.

      ~([1 2 3] | count | eq 3)
  ~~|
  ::verb~(:returns ::number | ::builtin{:impl :qlang/prim/count})

:empty
  |~~ Whether the vector holds no element.

      ~([] | empty | eq true)
  ~~|
  ::verb~(:returns ::boolean | ::builtin{:impl :qlang/prim/empty})

:first
  |~~ The first element, or null for the empty vector.

      ~([10 20 30] | first | eq 10)
  ~~|
  ::verb~(::builtin{:impl :qlang/prim/first})

:last
  |~~ The last element, or null for the empty vector.

      ~([10 20 30] | last | eq 30)
  ~~|
  ::verb~(::builtin{:impl :qlang/prim/last})

:sum
  |~~ The sum of the elements, each a number.

      ~([1 2 3 4] | sum | eq 10)
  ~~|
  ::verb~(:returns ::number | ::builtin{:impl :qlang/prim/sum})

:min
  |~~ The first element in the one order of values.

      ~([3 1 4 1 5] | min | eq 1)
  ~~|
  ::verb~(::builtin{:impl :qlang/prim/min})

:max
  |~~ The last element in the one order of values.

      ~([3 1 4 1 5] | max | eq 5)
  ~~|
  ::verb~(::builtin{:impl :qlang/prim/max})

:filter
  |~~ The elements whose predicate answers true, in their order.

      ~([1 2 3 4 5] | filter ~(gt 2) | eq [3 4 5])
  ~~|
  ::verb~(:predicate ::quote | :returns / | ::builtin{:impl :qlang/prim/filter})

:every
  |~~ Whether the predicate answers true for every element.

      ~([2 4 6 8] | every ~(gt 0) | eq true)
  ~~|
  ::verb~(:predicate ::quote | :returns ::boolean | ::builtin{:impl :qlang/prim/every})

:any
  |~~ Whether the predicate answers true for some element.

      ~([1 2 3] | any ~(gt 2) | eq true)
  ~~|
  ::verb~(:predicate ::quote | :returns ::boolean | ::builtin{:impl :qlang/prim/any})

:groupBy
  |~~ The map of vectors the key sorts the elements into.

      ~([{:k :a :v 1} {:k :b :v 2} {:k :a :v 3}] | groupBy ~(/k) | /a * /v | eq [1 3])
  ~~|
  ::verb~(:key ::quote | :returns ::map | ::builtin{:impl :qlang/prim/groupBy})

:indexBy
  |~~ The map of the elements under the key each answers, the last
      element winning a key two share.

      ~([{:id :a :n 1} {:id :b :n 2}] | indexBy ~(/id) | /b/n | eq 2)
  ~~|
  ::verb~(:key ::quote | :returns ::map | ::builtin{:impl :qlang/prim/indexBy})

:sort
  |~~ The elements in the one order of values, or by the value the key
      answers for each.

      ~([3 1 4 1 5] | sort | eq [1 1 3 4 5])
      ~([{:age 30} {:age 20}] | sort ~(/age) | eq [{:age 20} {:age 30}])
  ~~|
  ::verb~(:key #[::quote ::null] | :returns / | ::builtin{:impl :qlang/prim/sort})

:take
  |~~ The first count elements.

      ~([1 2 3 4 5] | take 3 | eq [1 2 3])
  ~~|
  ::verb~(:count ::number | :returns / | ::builtin{:impl :qlang/prim/take})

:drop
  |~~ The elements after the first count.

      ~([1 2 3 4 5] | drop 2 | eq [3 4 5])
  ~~|
  ::verb~(:count ::number | :returns / | ::builtin{:impl :qlang/prim/drop})

:at
  |~~ The element at the index, a negative one counting from the end,
      or null past either end.

      ~([10 20 30] | at 1 | eq 20)
      ~([10 20 30] | at -1 | eq 30)
  ~~|
  ::verb~(:index ::number | ::builtin{:impl :qlang/prim/at})

:distinct
  |~~ The set of the elements, the vector in the one order without
      duplicates.

      ~([2 1 2 3 1] | distinct | eq #[1 2 3])
  ~~|
  ::verb~(:returns / | ::builtin{:impl :qlang/prim/distinct})

:reverse
  |~~ The elements in the reverse order.

      ~([1 2 3] | reverse | eq [3 2 1])
  ~~|
  ::verb~(:returns / | ::builtin{:impl :qlang/prim/reverse})

:flat
  |~~ The elements with one level of nesting spliced in.

      ~([[1 2] [3] [4 5]] | flat | eq [1 2 3 4 5])
  ~~|
  ::verb~(:returns / | ::builtin{:impl :qlang/prim/flat})

:reduce
  |~~ The seed folded over the elements by the reducer.

      ~([1 2 3 4 5] | reduce 0 ~(add) | eq 15)
  ~~|
  ::verb~(:seed ::any | :reducer ::quote | ::builtin{:impl :qlang/prim/reduce})
