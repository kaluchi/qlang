{
  "name": "@kaluchi/qlang-core",
  "version": "0.10.0",
  "description": "Reference implementation of the qlang pipeline query language",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": {
      "import": "./src/index.mjs"
    },
    "./session": {
      "import": "./src/session.mjs"
    },
    "./errors": {
      "import": "./src/errors.mjs"
    },
    "./highlight": {
      "import": "./src/highlight.mjs"
    },
    "./lib/qlang.qlang": "./lib/qlang.qlang",
    "./lib/qlang/*.qlang": "./lib/qlang/*.qlang"
  },
  "imports": {
    "#qlang": "./lib/qlang.qlang",
    "#qlang/load-source": {
      "node": "./host/load-source-node.mjs",
      "default": "./src/load-source-web.mjs"
    },
    "#qlang/*": "./lib/qlang/*.qlang"
  },
  "sideEffects": [
    "./src/runtime/*.mjs"
  ],
  "files": [
    "src/",
    "host/",
    "lib/",
    "gen/"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:grammar": "node scripts/build-grammar.mjs",
    "build": "node scripts/build-grammar.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "query-language",
    "interpreter",
    "pipeline"
  ],
  "license": "Apache-2.0",
  "author": "kaluchi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaluchi/qlang.git"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "peggy": "^5.1.0",
    "vitest": "^5.0.0"
  }
}
