{"name":"filter-set-0arity-conduit","query":"#[1 2 3 4 5] | :big gt 2 | filter ~(big)","expect":"#[3 4 5]"}
{"name":"filter-set-1arity-conduit","query":"#[1 -2 3 -4 5] | :@pos [:v] (v | gt 0) | filter ~(@pos)","expect":"#[1 3 5]"}
{"name":"filter-map-0arity-conduit","query":"{:a 1 :b 2 :c 3} | :big gt 1 | filter ~(big)","expect":"{:b 2 :c 3}"}
