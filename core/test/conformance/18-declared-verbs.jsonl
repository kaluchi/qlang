{"name":"a-declared-verb-without-slots","query":":double ::verb~(mul 2) | 10 | double","expect":"20"}
{"name":"a-declared-verb-under-distribute","query":":plus10 ::verb~(add 10) | [1 2 3] * plus10","expect":"[11 12 13]"}
{"name":"a-declared-verb-with-one-slot","query":":addN ::verb~(:n ::any | add n) | 5 | addN 3","expect":"8"}
{"name":"a-declared-verb-with-two-slots","query":":@surround ::verb~(:pfx ::any | :sfx ::any | prepend pfx | append sfx) | \"world\" | @surround \"[\" \"]\"","expect":"\"[world]\""}
{"name":"a-slot-of-code-keys-a-sort","query":":@topBy ::verb~(:keyFn ::quote | :n ::number | sort keyFn | reverse | take n) | [{:v 1} {:v 3} {:v 2}] | @topBy ~/v 2 * /v","expect":"[3 2]"}
{"name":"a-slot-of-code-filters","query":":@matching ::verb~(:pred ::quote | filter pred) | [1 2 3 4 5] | @matching ~(gt 3)","expect":"[4 5]"}
{"name":"fractal-composition-three-levels","query":":@topBy ::verb~(:keyFn ::quote | :n ::number | sort keyFn | reverse | take n) | :@topNByV ::verb~(:n ::number | @topBy ~/v n) | :@top2ByV ::verb~(@topNByV 2) | [{:v 10} {:v 30} {:v 20}] | @top2ByV * /v","expect":"[30 20]"}
{"name":"a-declared-verb-recurses-over-a-tree","query":":totalSize ::verb~(add /size (/children * totalSize | sum)) | {:size 0 :children [{:size 100 :children []} {:size 200 :children []}]} | totalSize","expect":"300"}
{"name":"a-declared-verb-recurses-with-its-slot-of-code","query":":@treeMap ::verb~(:fn ::quote | {:label (/label | apply fn) :children (/children * @treeMap fn)}) | {:label \"a\" :children [{:label \"b\" :children []}]} | @treeMap ~(append \"!\") | /label","expect":"\"a!\""}
{"name":"a-declared-verb-refuses-a-slot-left-empty","query":":f ::verb~(:a ::any | :b ::any | add a b) | 0 | f 1","error":"arityError","expect":"::VerbSlotMissingError!{\n  :faultStep ~(f 1)\n  :faultInput 0\n  :verbName :f\n  :slot :b\n}"}
{"name":"a-declared-verb-refuses-modifiers-beyond-its-slots","query":":f ::verb~(:a ::any | add a) | 5 | f 1 2","error":"arityError","expect":"::VerbModifiersBeyondSlotsError!{\n  :faultStep ~(f 1 2)\n  :faultInput 5\n  :verbName :f\n  :slotCount 1\n  :actualCount 2\n}"}
{"name":"a-slot-shadows-a-builtin","query":":f ::verb~(:count ::any | count) | 42 | f 99","expect":"99"}
{"name":"lexical-scope-isolation","query":":double ::verb~(mul 2) | :apply_double ::verb~(double) | (:double ::verb~(mul 3) | 5 | apply_double)","expect":"10"}
{"name":"a-freeze-inside-a-verb-body-does-not-leak","query":":f ::verb~(:n ::any | n | :captured / | add captured n) | 0 | f 3 | env | has :captured","expect":"false"}
{"name":"a-slot-takes-its-modifier-at-each-call","query":":@pluck ::verb~(:proj ::any | proj) | [{:a 1} {:a 2} {:a 3}] * @pluck /a","expect":"[1 2 3]"}
{"name":"a-declared-verb-source-axis","query":":double ::verb~(mul 2) | :double | source | parse","expect":"\":double ::verb~(mul 2)\""}
{"name":"a-verb-effect-marker-clean-body-at-name-ok","query":":@safe ::verb~(count) | [1 2 3] | @safe","expect":"3"}
{"name":"a-verb-effectful-body-under-a-clean-name-rejected","query":":foo ::verb~(@callers) !| type","expect":"::EffectLaunderingAtBindStepParseError"}
{"name":"a-slot-holding-a-value-takes-no-modifiers","query":":f ::verb~(:n ::any | n 42) | 0 | f 5 !| type","expect":"::ApplyToNonFunctionError"}
{"name":"runaway-self-call-lifts-depth-error","query":":inf ::verb~(add 1 | inf) | 0 | inf !| type","expect":"::EvaluationDepthExceededError"}
{"name":"runaway-self-call-descriptor-depth-past-limit","query":":inf ::verb~(add 1 | inf) | 0 | inf !| gt /depth /limit","expect":"true"}
{"name":"runaway-self-apply-lifts-depth-error","query":":q ~(apply q) | apply q !| type","expect":"::EvaluationDepthExceededError"}
{"name":"runaway-distribute-lifts-depth-error","query":":f ::verb~([/] * f | first) | 1 | f !| type","expect":"::EvaluationDepthExceededError"}
{"name":"runaway-tag-constructor-lifts-depth-error","query":"::T {:impl ~(::T(/))} | ::T(1) !| type","expect":"::EvaluationDepthExceededError"}
