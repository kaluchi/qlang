{"name":"and-both-true","query":"true | and true","expect":"true"}
{"name":"and-one-false","query":"true | and false","expect":"false"}
{"name":"or-one-true","query":"false | or true","expect":"true"}
{"name":"or-both-false","query":"false | or false","expect":"false"}
{"name":"not-true","query":"true | not","expect":"false"}
{"name":"not-false","query":"false | not","expect":"true"}
{"name":"not-null-is-refused","query":"null | not !| get [~(type) /actualType]","expect":"[::boolean/not/SubjectNotBooleanError ::null]"}
{"name":"not-zero-is-refused","query":"0 | not !| type","expect":"::boolean/not/SubjectNotBooleanError"}
{"name":"not-empty-string-is-refused","query":"\"\" | not !| type","expect":"::boolean/not/SubjectNotBooleanError"}
{"name":"filter-with-and","query":"[{:active true :age 25} {:active true :age 15} {:active false :age 30}] | filter ~(allOf (get /active) (get /age | gte 18))","expect":"[{:active true :age 25}]"}
{"decision":"D352","name":"and-refuses-a-subject-of-another-kind","query":"1 | and true !| type","expect":"::boolean/and/SubjectNotBooleanError"}
{"decision":"D352","name":"or-refuses-a-condition-of-another-kind","query":"true | or 1 !| type","expect":"::boolean/or/condition/KindNotTakenError"}
{"decision":"D352","name":"a-predicate-may-name-a-verb","query":"[true false] | filter ~(not)","expect":"[false]"}
{"name":"allOf-holds-two-conditions-of-one-record","query":"{:active true :age 25} | allOf (get /active) (get /age | gte 18)","expect":"true"}
{"name":"all-of-computes-every-condition-at-the-call","query":"{:email null} | allOf (get /email | ne null) (get /email | endsWith \".org\") !| get [~(type) /index /actualType]","expect":"[::any/allOf/conditions/ElementKindNotTakenError 1 ::string/endsWith/SubjectNotStringError]"}
{"name":"all-of-runs-a-quote-in-its-turn","query":"[{:email null} {:email \"a@b.org\"}] | filter ~(allOf (get /email | ne null) ~(get /email | endsWith \".org\")) | count","expect":"1"}
{"name":"a-condition-of-allOf-is-a-value-or-a-quote","query":"5 | allOf (gt 1) ~(lt 10)","expect":"true"}
{"name":"if-holds-two-conditions-by-allOf","query":"{:active true :verified true} | if (allOf (get /active) (get /verified)) ~(\"go\") ~(\"stop\")","expect":"\"go\""}
{"name":"if-takes-either-condition-by-anyOf","query":"{:vip false :score 99} | if (anyOf (get /vip) (get /score | gt 95)) ~(\"premium\") ~(\"standard\")","expect":"\"premium\""}
{"name":"split-then-filter","query":"\"a,b,c,d\" | split \",\" | filter ~(allOf (eq \"a\" | not) (eq \"c\" | not))","expect":"[\"b\" \"d\"]"}
{"name":"allOf-takes-one-condition-at-least","query":"5 | allOf !| type","expect":"::any/allOf/conditions/EmptyError"}
{"name":"a-condition-of-allOf-answers-a-boolean","query":"5 | allOf ~(1) !| type","expect":"::any/allOf/ConditionNotBooleanError"}
{"name":"a-path-is-a-condition-of-allOf","query":"{:a true :b true} | allOf /a /b","expect":"true"}
{"name":"a-failure-computed-at-the-call-is-refused-before-the-kinds-of-the-conditions","query":"get [~(5 | allOf 3 true !| get /index) ~(5 | allOf 3 (1 | div 0) !| get /index)]","expect":"[0 1]"}
