{"decision":"D386","name":"every-kind-compares-two-of-its-values-by-the-one-order","query":"get [~(true | gt false) ~([1 2] | gt [1]) ~({:b 1} | gt {:a 1}) ~(#[2] | gt #[1]) ~(null | gte null) ~(/b | gt /a) ~(::Width#5 | gt ::Width#3)]","expect":"[true true true true true true true]"}
{"name":"strings-keywords-and-tag-names-compare-within-their-kind","query":"get [~(\"b\" | gt \"a\") ~(:b | gt :a) ~(::b | gt ::a)]","expect":"[true true true]"}
{"decision":"D383","name":"eq-answers-the-tie-of-the-one-order-over-every-kind","query":"get [~(#\"a\"i | eq #\"a\"i) ~(#\"a\"i | eq #\"a\") ~(/a/0 | eq /a/0) ~(1 | desc | eq (1 | desc)) ~({:b [1] :a #[2]} | eq {:a #[2] :b [1]}) ~(~(add 1) | eq ~(add 1))]","expect":"[true false true true true true]"}
{"decision":"D386","name":"the-order-ranks-every-value-while-a-comparison-relates-two-of-one-kind","query":"get [~([1 \"a\"] | max) ~([1 \"a\"] | sort) ~(\"a\" | gt 1 !| type)]","expect":"[\"a\" [1 \"a\"] ::any/gt/KindsMismatchedError]"}
{"decision":"D386","name":"a-comparison-refuses-two-tags-and-a-tag-beside-its-payload","query":"get [~(::Cents#100 | gt ::Dollars#50 !| get [~(type) /leftType /rightType]) ~(::Width#5 | gt 3 !| get [/leftType /rightType]) ~(::Width#5 | payload | gt 3)]","expect":"[[::any/gt/KindsMismatchedError ::Cents ::Dollars] [::Width ::number] true]"}
