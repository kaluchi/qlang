{"name":"map-multiplies-each-element","query":"[1 2 3] | map (mul 10)","expect":"[10 20 30]"}
{"name":"map-over-a-set","query":"#[1 2 3] | map (add 1)","expect":"[2 3 4]"}
{"name":"map-over-a-set-in-the-one-order","query":"#[3 1 2] | map (add 1)","expect":"[2 3 4]"}
{"name":"map-over-a-set-keeps-an-image-per-element","query":"#[1 2 3] | map (mul 0)","expect":"[0 0 0]"}
{"name":"map-reaches-the-set-beneath-a-tag","query":"::Box#[1 2] | map (add 1)","expect":"[2 3]"}
{"name":"map-reaches-the-vector-beneath-two-tags","query":"::A::B[1 2] | map (add 1)","expect":"[2 3]"}
{"name":"map-keeps-the-order-of-the-keys","query":"{:b 2 :a 1} | map (add 1) | vals","expect":"[3 2]"}
{"name":"map-answers-what-each-element-answers","query":"[1 2 3] | map (add 1)","expect":"[2 3 4]"}
{"name":"map-keeps-the-keys-of-a-map","query":"{:a 1 :b 2} | map (add 1)","expect":"{:a 2 :b 3}"}
{"name":"map-over-a-set-answers-the-vector-of-the-images","query":"#[1 2 3] | map (gt 1)","expect":"[false true true]"}
{"name":"map-answers-the-first-error-of-its-code","query":"[1 \"x\" \"y\"] | map (add 1) !| trace | first | subject","expect":"\"x\""}
{"name":"map-answers-under-no-tag-of-the-subject","query":"::Box[1 2] | map (add 1)","expect":"[2 3]"}
{"name":"a-sum-over-a-listing-of-the-catalog-counts-every-element","query":"::vec | manifest | map (laws | count) | sum | eq (::vec | manifest | sort | map (laws | count) | sum)","expect":"true"}
{"decision":"D496","name":"map-builds-a-template-on-each-element","query":"[{:name \"Ann\" :tags [1 2]}] | map {:name /name :count (get /tags | count)}","expect":"[{:name \"Ann\" :count 2}]"}
{"decision":"D496","name":"map-refuses-code-quoted-where-it-takes-it-bare","query":"[1 2] | map ~(mul 2) !| tag","expect":"::vec/map/CodeQuotedError"}
{"decision":"D496","name":"map-refuses-a-quote-under-a-tag-written-in-the-step","query":"[1 2] | map ::quote~(add 1) !| tag","expect":"::vec/map/CodeQuotedError"}
{"decision":"D496","name":"map-refuses-the-identity-quoted-naming-it","query":"[1 2] | map ~() !| tag","expect":"::vec/map/CodeQuotedError"}
