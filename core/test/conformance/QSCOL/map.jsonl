{"decision":"D364","name":"keys-answers-the-set-of-the-keys-of-a-map","query":"{:name \"Alice\" :age 30} | keys","expect":"#[:age :name]"}
{"decision":"D364","name":"vals-answers-the-vector-of-the-values-of-a-map","query":"{:name \"Alice\" :age 30} | vals","expect":"[\"Alice\" 30]"}
{"name":"vals-map-yields-vec","query":"{:a 1 :b 2} | vals | type","expect":"::vec"}
{"name":"keys-map-yields-set","query":"{:a 1 :b 2} | keys | type","expect":"::set"}
{"name":"keys-map-elements-are-keywords","query":"{:a 1 :b 2} | keys | first | type","expect":"::keyword"}
{"name":"the-keys-of-a-map-equal-a-set-of-them-written-in-another-order","query":"{:a 1 :b 2} | keys | eq #[:b :a]","expect":"true"}
{"name":"sort-orders-the-entries-by-value","query":"{:a 3 :b 1 :c 2} | sort | vals","expect":"[1 2 3]"}
{"name":"sort-keeps-the-key-of-each-value","query":"{:a 3 :b 1} | sort | take 1","expect":"{:b 1}"}
{"name":"take-cuts-the-first-entries","query":"{:a 1 :b 2 :c 3} | take 2","expect":"{:a 1 :b 2}"}
{"name":"drop-cuts-the-first-entries-away","query":"{:a 1 :b 2 :c 3} | drop 2","expect":"{:c 3}"}
{"name":"reverse-reverses-the-entries","query":"{:a 1 :b 2} | reverse | vals","expect":"[2 1]"}
{"name":"sum-reads-the-values","query":"{:a 1 :b 2} | sum","expect":"3"}
{"name":"min-reads-the-values","query":"{:a 3 :b 1} | min","expect":"1"}
{"name":"max-reads-the-values","query":"{:a 3 :b 1} | max","expect":"3"}
{"name":"first-reads-the-first-value","query":"{:a 1 :b 2} | first","expect":"1"}
{"name":"last-reads-the-last-value","query":"{:a 1 :b 2} | last","expect":"2"}
{"name":"keys-answers-the-sorted-set-of-keys","query":"{:b 1 :a 2} | keys | first","expect":":a"}
{"name":"first-of-an-empty-map-is-null","query":"{} | first","expect":"null"}
{"name":"entries-answers-the-pairs-of-a-map","query":"{:a 1 :b 2} | entries","expect":"[[:a 1] [:b 2]]"}
{"name":"a-key-stands-beside-its-value-in-a-record","query":"{:auth {:port 3000} :db {:port 5432}} | entries | map ~(unionOf /1 (get {:name ~(get /0 | toString)})) | sort /port","expect":"[{:port 3000 :name \"auth\"} {:port 5432 :name \"db\"}]"}
{"decision":"D364","name":"keys-of-the-empty-map-answers-the-empty-set","query":"{} | keys","expect":"#[]"}
{"decision":"D364","name":"vals-of-the-empty-map-answers-the-empty-vector","query":"{} | vals","expect":"[]"}
{"name":"size-and-length-answer-as-count-over-a-map","query":"{:a 1 :b 2} | get [~(size) ~(length) ~(count)]","expect":"[2 2 2]"}
