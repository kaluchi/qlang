{"name":"count","query":"[1 2 3 4 5] | count","expect":"5"}
{"name":"count-empty","query":"[] | count","expect":"0"}
{"name":"empty-true","query":"[] | empty","expect":"true"}
{"name":"empty-false","query":"[1] | empty","expect":"false"}
{"name":"first","query":"[10 20 30] | first","expect":"10"}
{"name":"first-empty","query":"[] | first","expect":"null"}
{"name":"last","query":"[10 20 30] | last","expect":"30"}
{"name":"last-empty","query":"[] | last","expect":"null"}
{"name":"sum","query":"[1 2 3 4 5] | sum","expect":"15"}
{"name":"sum-empty","query":"[] | sum","expect":"0"}
{"name":"min","query":"[3 1 4 1 5 9 2 6] | min","expect":"1"}
{"name":"max","query":"[3 1 4 1 5 9 2 6] | max","expect":"9"}
{"name":"take","query":"[1 2 3 4 5] | take 3","expect":"[1 2 3]"}
{"name":"drop","query":"[1 2 3 4 5] | drop 2","expect":"[3 4 5]"}
{"name":"reverse","query":"[1 2 3] | reverse","expect":"[3 2 1]"}
{"name":"flat","query":"[[1 2] [3] [4 5]] | flat","expect":"[1 2 3 4 5]"}
{"name":"append-puts-an-element-after-a-vector","query":"[1 2] | append 3","expect":"[1 2 3]"}
{"name":"prepend-puts-an-element-before-a-vector","query":"[2 3] | prepend 1","expect":"[1 2 3]"}
{"name":"append-takes-a-vector-as-one-element","query":"[1] | append [2 3]","expect":"[1 [2 3]]"}
{"name":"append-keeps-the-set-of-its-subject","query":"#[1 2] | append 3","expect":"#[1 2 3]"}
{"name":"take-negative-clamps-to-empty","query":"[1 2 3] | take -1","expect":"[]"}
{"name":"take-negative-large-clamps-to-empty","query":"[1 2 3] | take -5","expect":"[]"}
{"name":"drop-negative-clamps-to-whole","query":"[1 2 3] | drop -1","expect":"[1 2 3]"}
{"name":"drop-negative-large-clamps-to-whole","query":"[1 2 3] | drop -5","expect":"[1 2 3]"}
{"name":"take-over-length-returns-whole","query":"[1 2 3] | take 5","expect":"[1 2 3]"}
{"name":"drop-over-length-returns-empty","query":"[1 2 3] | drop 5","expect":"[]"}
{"name":"take-negative-on-set-clamps-to-empty","query":"#[1 2 3] | take -1 | count","expect":"0"}
{"name":"drop-negative-on-set-clamps-to-whole","query":"#[1 2 3] | drop -1 | count","expect":"3"}
{"name":"has-set-true","query":"#[:a :b :c] | has :b","expect":"true"}
{"name":"has-set-false","query":"#[:a :b :c] | has :d","expect":"false"}
