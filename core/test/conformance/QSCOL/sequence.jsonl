{"name":"avg-refuses-an-element-that-is-no-number","query":"[1 \"x\"] | avg !| get [~(type) /index]","expect":"[::vec/avg/ElementNotNumberError 1]"}
{"name":"a-set-holds-any-element","query":"#[1 \"a\"] | has 42","expect":"false"}
{"name":"flat-of-sets-is-their-union","query":"#[#[3 1] #[2 1]] | flat","expect":"#[1 2 3]"}
{"name":"first-of-an-empty-set-is-null","query":"#[] | first","expect":"null"}
