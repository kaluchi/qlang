{"name":"a-verb-declared-under-a-kind-serves-its-values","query":":Box |~~ Box. ~~| | :Box/twice (::fn | returns |~~ The answer. ~~| ::number | impl ~(get /w | mul 2)) | ::Box{:w 3} | twice","expect":"6"}
{"name":"a-verb-a-body-computes-under-a-kind-serves-the-kind","query":":Box |~~ Box. ~~| | :Box/h (~(tag)) | ::Box{} | h","expect":"::Box"}
{"name":"a-name-resides-under-the-label-it-is-declared-under","query":":T |~~ T ~~| | :T/tk (::vec/take | binding | value) | get [~(::T[1 2 3] | tk 2) ~([1 2 3] | T/tk 2 !| tag)]","expect":"[[1 2] ::T/tk/SubjectNotTError]"}
{"name":"a-name-under-a-label-refuses-a-subject-of-another-kind","query":":number/inc ~(add 1) | \"a\" | inc !| tag","expect":"::number/inc/SubjectNotNumberError"}
{"name":"a-name-under-a-kind-serves-its-values-and-refuses-another-subject","query":"get [~(5 | add 1) ~(\"x\" | add 1 !| tag)]","expect":"[6 ::number/add/SubjectNotNumberError]"}
{"name":"the-head-raises-the-refusal-of-the-site-at-the-subject","query":"\"a\" | add 1 !| get [~(tag) /actualTag]","expect":"[::number/add/SubjectNotNumberError ::string]"}
{"name":"a-comparison-of-strings-resides-on-strings","query":"\"b\" | gt \"a\"","expect":"true"}
{"name":"a-comparison-of-keywords-resides-on-keywords","query":":b | lt :a","expect":"false"}
{"name":"a-comparison-refuses-a-pair-of-two-kinds","query":"1 | gt \"x\" !| tag","expect":"::call/KindsMismatchedError"}
{"name":"a-call-by-address-reaches-the-residence","query":"5 | any/gt 3","expect":"true"}
{"name":"a-call-by-address-checks-the-subject-by-the-residence","query":"\"a\" | number/add 1 !| tag","expect":"::number/add/SubjectNotNumberError"}
{"name":"a-set-is-a-vector-to-a-verb-of-vectors","query":"#[1 2] | vec/count","expect":"2"}
{"name":"a-set-reaches-the-verbs-of-vectors-it-does-not-declare-an-answer-of-their-label-back-as-a-set-and-the-images-of-map-a-vector","query":"#[3 1 2] | get [~(binding :count | name) ~(filter ~(gt 1)) ~(take 2) ~(map ~(mul 2))]","expect":"[:vec/count #[2 3] #[1 2] [2 4 6]]"}
{"name":"a-verb-of-any-value-is-called-by-its-address","query":"\"x\" | any/type","expect":"::string"}
{"name":"an-address-of-a-verb-of-strings-checks-its-subject","query":"[1] | string/prepend 0 !| tag","expect":"::string/prepend/SubjectNotStringError"}
{"name":"a-verb-of-one-residence-refuses-its-subject-by-its-site","query":"[1] | split \",\" !| tag","expect":"::string/split/SubjectNotStringError"}
{"name":"join-resides-on-the-vector","query":"\"a\" | join \",\" !| tag","expect":"::vec/join/SubjectNotVecError"}
{"name":"not-resides-on-the-boolean","query":"5 | not !| tag","expect":"::boolean/not/SubjectNotBooleanError"}
{"name":"eq-takes-any-value","query":"1 | eq \"a\"","expect":"false"}
{"name":"parse-json-resides-on-the-string","query":"5 | parseJson !| tag","expect":"::string/parseJson/SubjectNotStringError"}
{"name":"a-name-with-a-path-calls-by-address","query":"[1 2 3] | vec/count","expect":"3"}
{"name":"a-verb-serves-the-kinds-on-names-beside-the-values-of-its-label","query":":Shop |~~ A shop. ~~| (::kind | accepts |~~ The sizes. ~~| ::map) | :Shop/double |~~ Doubles. ~~| (::fn | on |~~ A number or a keyword. ~~| #[::number ::keyword] | impl ~(get [~(it) ~(it)])) | get [~(5 | double) ~(:k | double) ~(\"x\" | double !| tag)]","expect":"[[5 5] [:k :k] ::Shop/double/SubjectNotShopError]"}
{"name":"keys-of-a-number-is-refused-by-the-one-verb-of-its-name","query":"42 | keys","raises":"::map/keys/SubjectNotMapError!{\n  :actualTag ::number\n  :trace ::trace[::frame[42 ~(keys)]]\n}"}
{"name":"vals-of-a-vector-is-refused-by-the-one-verb-of-its-name","query":"[1 2] | vals","raises":"::map/vals/SubjectNotMapError!{\n  :actualTag ::vec\n  :trace ::trace[::frame[[1 2] ~(vals)]]\n}"}
{"name":"a-residence-takes-its-subject-by-the-walk-of-its-tags","query":":Box |~~ Box. ~~| | :Box/w2 ~(get /w | mul 2) | get [~(::Box{:w 3} | Box/w2) ~({:w 3} | Box/w2 !| tag)]","expect":"[6 ::Box/w2/SubjectNotBoxError]"}
{"name":"a-subject-is-taken-by-the-walk-of-its-tags","query":":Pos |~~ Pos. ~~| (::kind | holds :NotPositiveError |~~ Above zero. ~~| ~(gt 0)) | :Pos/f ~(payload) | get [~(::Pos#5 | f) ~(5 | f !| tag) ~(::Pos#0 !| tag)]","expect":"[5 ::Pos/f/SubjectNotPosError ::Pos/NotPositiveError]"}
{"name":"a-comparison-of-tags-resides-on-tags","query":"::b | gte ::a","expect":"true"}
{"name":"an-input-refuses-under-the-address-of-its-kinds-verb","query":"get [~(\"ab\" | take \"x\" !| tag) ~([1] | take \"x\" !| tag)]","expect":"[::string/take/count/KindNotTakenError ::vec/take/count/KindNotTakenError]"}
{"name":"a-subject-that-is-no-string-is-refused-by-the-address","query":"42 | string/contains \"x\"","raises":"::string/contains/SubjectNotStringError!{\n  :actualTag ::number\n  :trace ::trace[::frame[42 ~(string/contains \"x\")]]\n}"}
{"name":"zip-resides-on-vectors-and-sets-whose-addresses-a-number-is-refused-with","query":"42 | zip !| get [~(tag) /addresses]","expect":"[::call/KindAnswersNoVerbError #[::set/zip ::vec/zip]]"}
