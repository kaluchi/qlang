{"decision":"D363","name":"a-template-reads-a-value-back-from-the-set-of-its-atoms","query":"#[1 \"x\" :a :b] | apply ~(get [/1 [/0 /0] ~(get [[/3 /2]] | indexBy ~(first) | map ~last)])","expect":"[\"x\" [1 1] {:b :a}]"}
