{"name":"an-error-comes-back-from-the-atoms-of-its-facts","query":"#[1 :k ::FooError ::error] | get [/2 ~(get [/3 ~(get [[/1 /0]] | indexBy ~(first) | map ~last)] | tag)] | tag","expect":"::FooError!{:k 1}"}
