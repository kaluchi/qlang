{"name":"json-object-with-unicode-key","query":"{\"k\\u0065y\": 42} | get /key","expect":"42"}
{"name":"type-json-array-syntax-reads-as-a-vector","query":"[1, 2] | type","expect":"::vec"}
{"name":"type-json-object-syntax-reads-as-a-map","query":"{\"k\": 1} | type","expect":"::map"}
{"name":"json-object-string-key","query":"{\"name\": \"alice\"}","expect":"{:name \"alice\"}"}
{"name":"json-object-multiple-keys","query":"{\"name\": \"alice\", \"age\": 30}","expect":"{:name \"alice\" :age 30}"}
{"name":"json-object-nested","query":"{\"user\": {\"name\": \"alice\"}}","expect":"{:user {:name \"alice\"}}"}
{"name":"json-object-in-vec","query":"[{\"name\": \"alice\"}, {\"name\": \"bob\"}] | map /name","expect":"[\"alice\" \"bob\"]"}
{"name":"get-reads-a-key-of-a-json-object-in-the-pipe","query":"{\"name\": \"alice\"} | get /name","expect":"\"alice\""}
{"name":"json-null-in-vec","query":"[1, null, 3]","expect":"[1 null 3]"}
{"name":"json-array-with-json-objects","query":"[{\"v\": 1}, {\"v\": 2}] | count","expect":"2"}
{"name":"json-object-pipeline","query":"{\"scores\": [85 92 78]} | get /scores | count","expect":"3"}
{"name":"a-json-key-that-is-no-bare-name-is-read-by-a-quoted-segment","query":"{\"$ref\": \"x\"} | get /\"$ref\"","expect":"\"x\""}
{"name":"json-string-key-equals-keyword","query":"{\"name\": 1} | get /name","expect":"1"}
{"name":"json-form-keys-only","query":"{\"a\": 1, \"b\": 2} | get [/a /b]","expect":"[1 2]"}
{"name":"scientific-in-json-object","query":"{\"v\": 1e10, \"e\": 2.5e-3} | get [/v, /e]","expect":"[10000000000 0.0025]"}
{"name":"scientific-in-pipeline","query":"{\"rate\": 1.5e-2} | get /rate","expect":"0.015"}
{"name":"json-deep-nesting","query":"{\"a\": {\"b\": {\"c\": 42}}} | get /a/b/c","expect":"42"}
{"name":"json-boolean-values","query":"{\"x\": true, \"y\": false} | get [/x, /y]","expect":"[true false]"}
{"name":"json-null-value","query":"{\"x\": null} | get /x","expect":"null"}
{"name":"json-array-value-sum","query":"{\"items\": [1 2 3]} | get /items | sum","expect":"6"}
{"name":"json-full-roundtrip","query":"{\"name\": \"alice\", \"age\": 30, \"active\": true, \"score\": null} | get [/name, /age, /active, /score]","expect":"[\"alice\" 30 true null]"}
{"name":"map-reads-a-key-of-each-json-object-an-array-holds","query":"[{\"v\": 1e3}, {\"v\": 2e3}, {\"v\": 3e3}] | map /v","expect":"[1000 2000 3000]"}
{"name":"json-mixed-types-in-array","query":"[1, \"two\", true, null, 3.14]","expect":"[1 \"two\" true null 3.14]"}
{"name":"json-object-reads-as-a-map","query":"{\"a\": 1} | type","expect":"::map"}
{"name":"json-object-keys-are-keywords","query":"{\"a\": 1, \"b\": 2} | keys","expect":"#[:a :b]"}
{"name":"json-object-key-that-is-no-identifier-reads-quoted","query":"{\"a b\": 1} | keys","expect":"#[:\"a b\"]"}
{"name":"json-literal-prints-as-the-map-it-is","query":"{\"a\": [1, 2]} | eq {:a [1 2]}","expect":"true"}
{"name":"a-map-with-a-key-named-type-is-a-map","query":"{\"type\": \"quote\", \"source\": \"hi\"} | type","expect":"::map"}
{"name":"a-map-with-a-key-named-error-is-no-failure","query":"{\"type\": \"error\"} | ok !| false","expect":"true"}
{"name":"json-duplicate-key-reads-as-json-parse-reads-it","query":"{\"a\": 1, \"b\": 2, \"a\": 3} | vals","expect":"[3 2]"}
{"name":"a-map-that-writes-its-keys-both-ways-names-the-two","query":"\"{:a 1 \\\"b\\\": 2}\" | parse !| get /message","expect":"\"a map writes its keys one way, as keywords, `{:a 1 :b 2}`, or as the strings of JSON, `{\\\"a\\\": 1, \\\"b\\\": 2}`\""}
{"name":"a-comma-written-twice-or-last-or-missing-is-refused","query":"[\"[1,,2]\" \"[1,]\" \"{\\\"a\\\": 1 \\\"b\\\": 2}\" \"{:a 1, :b 2}\" \"#[1, 2]\"] | map ~(parse !| type)","expect":"[::quote/ParseError ::quote/ParseError ::quote/ParseError ::quote/ParseError ::quote/ParseError]"}
