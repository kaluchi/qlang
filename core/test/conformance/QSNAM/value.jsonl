{"name":"a-named-quote-is-a-value-apply-runs","query":"apply (:q ~(add 1); 5 | apply q)","expect":"6"}
{"name":"code-under-a-bare-name-runs-by-apply","query":"apply (:double ~(mul 2); 5 | apply double)","expect":"10"}
{"name":"code-under-a-bare-name-goes-bare-into-a-verb-that-takes-code","query":"apply (:double ~(mul 2); [1 2 3] | map double)","expect":"[2 4 6]"}
{"name":"a-bare-name-alone-reads-its-quote","query":"apply (:double ~(mul 2); double)","expect":"~(mul 2)"}
{"name":"a-reader-reads-a-doc-it-named","query":"|~~ note ~~| | with {:note it} (note | content)","expect":"\"note\""}
{"name":"an-input-holding-a-value-takes-no-modifiers","query":":number/f (::fn | takes :n |~~ The n. ~~| /0 | impl ~(n 42)); 0 | f 5 !| tag","expect":"::call/ValueTakesNoModifiersError"}
{"name":"a-name-that-holds-a-value-refuses-modifiers-holding-the-value","query":"apply (:five 5; five 42)","raises":"::call/ValueTakesNoModifiersError!{:found 5 :name :five :addresses #[] :trace ::trace[::frame[null ~(five 42)] ::frame[null ~(apply (:five 5; five 42))]]}"}
{"name":"a-bound-quote-stays-data","query":"apply (:q ~(add 1); 5 | (q))","expect":"~(add 1)"}
{"name":"a-name-is-read-back-by-its-bare-word","query":"{:qty 2 :price 3} | with [/qty /price] (qty | mul price)","expect":"6"}
{"name":"a-value-at-an-address-refuses-modifiers-under-the-name-declared","query":"apply (:Box |~~ Box. ~~|; :Box/side 3; Box/side 1 !| get [tag name])","expect":"[::call/ValueTakesNoModifiersError :Box/side]"}
{"name":"a-descriptor-a-name-holds-runs-nothing","query":"::builtin{} | with {:c it} (get [1 2 3] | (c | tag))","expect":"::builtin"}
{"name":"a-descriptor-a-query-assembles-is-a-value","query":"::builtin{:note :draft} | with {:u it} (get {:x 1} | (u | tag))","expect":"::builtin"}
{"name":"an-input-holding-a-value-refuses-modifiers-under-the-name-of-the-input","query":":number/f (::fn | takes :n |~~ The n. ~~| /0 | impl ~(n 42)); 0 | f 5 !| get [tag name]","expect":"[::call/ValueTakesNoModifiersError :n]"}
{"name":"a-value-written-as-a-later-step-is-refused-with-the-value-and-the-verbs-of-its-name","query":"7 | apply (:rest 5; add 1 | rest) !| get [tag name found addresses]","expect":"[::call/ValueAsALaterStepError :rest 5 #[]]"}
{"name":"a-node-of-data-written-as-a-later-step-is-refused-as-a-value-is","query":"apply (:Box |~~ A box. ~~|; :Box/side 3; 5 | Box/side !| get [tag name])","expect":"[::call/ValueAsALaterStepError :Box/side]"}
{"name":"a-name-read-after-the-fail-track-is-the-recovery","query":"{:default 0 :v \"x\"} | with [/default /v] (v | toNumber !| default)","expect":"0"}
{"name":"a-name-given-modifiers-as-a-later-step-takes-no-modifiers","query":"apply (:limit 1; 5 | limit 3) !| tag","expect":"::call/ValueTakesNoModifiersError"}
{"name":"a-name-read-at-the-head-of-a-group-after-a-step-answers-its-value","query":"apply (:rest 5; 7 | (rest))","expect":"5"}
