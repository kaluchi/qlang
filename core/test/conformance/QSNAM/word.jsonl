{"name":"filter-vec-declared-verb","query":"[1 2 3 4 5] | :number/big ~(gt 2) | filter ~(big)","expect":"[3 4 5]"}
{"name":"filter-vec-verb-predicate","query":"[1 -2 3 -4 5] | :number/positive ~(gt 0) | filter ~positive","expect":"[1 3 5]"}
{"name":"filter-set-declared-verb","query":"#[1 2 3 4 5] | :number/big ~(gt 2) | filter ~(big)","expect":"#[3 4 5]"}
{"name":"filter-set-verb-predicate","query":"#[1 -2 3 -4 5] | :number/positive ~(gt 0) | filter ~positive","expect":"#[1 3 5]"}
{"name":"filter-map-declared-verb","query":"{:a 1 :b 2 :c 3} | :number/big ~(gt 1) | filter ~(big)","expect":"{:b 2 :c 3}"}
{"name":"filter-map-verb-predicate","query":"{:a 1 :b -2 :c 3} | :number/positive ~(gt 0) | filter ~positive","expect":"{:a 1 :c 3}"}
{"name":"any-vec-declared-verb","query":"[1 2 3] | :any/big ~(gt 2) | any ~(big)","expect":"true"}
{"name":"any-vec-verb-predicate","query":"[1 2 3] | :any/big ~(gt 2) | any ~big","expect":"true"}
{"name":"any-vec-verb-predicate-false","query":"[1 2 3] | :any/huge ~(gt 99) | any ~huge","expect":"false"}
{"name":"every-vec-declared-verb","query":"[2 4 6] | :any/big ~(gt 0) | every ~(big)","expect":"true"}
{"name":"every-vec-verb-predicate","query":"[2 4 6] | :any/positive ~(gt 0) | every ~positive","expect":"true"}
{"name":"every-vec-verb-predicate-fails","query":"[2 4 -1] | :any/positive ~(gt 0) | every ~positive","expect":"false"}
{"name":"a-word-declared-under-a-label-runs-on-its-value","query":":number/double ~(mul 2) | 10 | double","expect":"20"}
{"name":"a-declared-word-runs-under-map","query":":number/plus10 ~(add 10) | [1 2 3] | map ~plus10","expect":"[11 12 13]"}
{"name":"tree-sum-leaf","query":":map/totalSize ~(sumOf /size (get /children | map ~totalSize | sum)) | {:size 100 :children []} | totalSize","expect":"100"}
{"name":"tree-sum-flat","query":":map/totalSize ~(sumOf /size (get /children | map ~totalSize | sum)) | {:size 0 :children [{:size 100 :children []} {:size 200 :children []}]} | totalSize","expect":"300"}
{"name":"tree-sum-nested-directories","query":":map/totalSize ~(sumOf /size (get /children | map ~totalSize | sum)) | {:label \"root\" :size 0 :children [{:label \"README.md\" :size 2048 :children []} {:label \"src\" :size 0 :children [{:label \"main.c\" :size 512 :children []} {:label \"util.c\" :size 256 :children []}]}]} | totalSize","expect":"2816"}
{"name":"tree-count-nodes","query":":map/countNodes ~(sumOf 1 (get /children | map ~countNodes | sum)) | {:children [{:children []} {:children [{:children []} {:children []}]}]} | countNodes","expect":"5"}
{"name":"tree-flatten-labels","query":":map/allLabels ~(get [[/label], ~(get /children | map ~allLabels | flat)] | flat) | {:label \"root\" :children [{:label \"a\" :children []} {:label \"b\" :children [{:label \"c\" :children []}]}]} | allLabels","expect":"[\"root\" \"a\" \"b\" \"c\"]"}
{"name":"tree-enrich-with-count","query":":map/withCounts ~(get {:label /label :count ~(get /children | count) :children ~(get /children | map ~withCounts)}) | {:label \"root\" :children [{:label \"a\" :children []} {:label \"b\" :children [{:label \"c\" :children []}]}]} | withCounts","expect":"{:label \"root\" :count 2 :children [{:label \"a\" :count 0 :children []} {:label \"b\" :count 1 :children [{:label \"c\" :count 0 :children []}]}]}"}
{"name":"tree-empty-children-terminates","query":":map/walk ~(get {:label /label :children ~(get /children | map ~walk)}) | {:label \"only\" :children []} | walk","expect":"{:label \"only\" :children []}"}
