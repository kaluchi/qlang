{"name":"a-declared-word-calls-a-word-of-its-subject","query":":vec/howMany ~(count) | [1 2 3] | howMany","expect":"3"}
{"name":"a-runaway-self-call-meets-the-budget-of-frames","query":":number/inf ~(add 1 | inf) | 0 | inf !| type","expect":"::call/EvaluationDepthExceededError"}
