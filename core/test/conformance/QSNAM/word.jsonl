{"name":"a-word-that-recurses-through-map-meets-the-budget-of-frames","query":":number/f ~(get [~(it)] | map ~f | first) | 1 | f !| type","expect":"::call/EvaluationDepthExceededError"}
{"name":"an-input-read-from-its-place-meets-the-budget-a-frame-below-its-call","query":":number/down ~(if (gt 0) ~(sub 1 | down) ~(apply ~(apply ~([] | map ~(x))))) | 498 | down !| type","expect":"::call/EvaluationDepthExceededError"}
{"name":"a-modifier-of-an-atom-meets-the-budget-a-frame-below-its-call","query":":number/down ~(if (gt 0) ~(sub 1 | down) ~(apply ~(apply ~([] | count 1)))) | 498 | down !| type","expect":"::call/EvaluationDepthExceededError"}
