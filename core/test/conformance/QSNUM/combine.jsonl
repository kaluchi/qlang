{"name":"sumOf-adds-two-fields-of-one-map","query":"{:x 10 :y 5} | sumOf /x /y","expect":"15"}
{"name":"subOf-subtracts-the-second-field-from-the-first","query":"{:x 10 :y 3} | subOf /x /y","expect":"7"}
{"name":"mulOf-multiplies-two-fields-of-one-map","query":"{:x 5 :y 4} | mulOf /x /y","expect":"20"}
{"name":"divOf-divides-the-first-field-by-the-second","query":"{:x 20 :y 4} | divOf /x /y","expect":"5"}
{"name":"a-call-takes-the-subject-in-the-pipe","query":"1 | add 1 2 !| get [~(tag) ~(doc | content | contains \"sumOf\")]","expect":"[::number/add/ArgsBeyondInputsError true]"}
{"name":"mulOf-multiplies-the-args-it-is-given","query":"{:price 4 :qty 3} | mulOf /price /qty","expect":"12"}
{"name":"a-call-on-a-subject-of-another-kind-names-the-form-that-fits","query":"{:price 100 :qty 3} | mul (get /price) (get /qty) !| get [~(tag) ~(doc | content | contains \"mulOf\")]","expect":"[::number/mul/SubjectNotNumberError true]"}
{"name":"two-fields-compare-by-the-subject-in-the-pipe","query":"{:a 2 :b 1} | gt (get /a) (get /b) !| tag","expect":"::any/gt/ArgsBeyondInputsError"}
{"name":"a-call-of-more-values-reads-the-page-of-its-refusal","query":"5 | eq 5 6 !| doc | content | contains \"one of several\"","expect":"true"}
{"name":"sumOf-takes-one-number-at-least","query":"{:a 1} | sumOf !| tag","expect":"::any/sumOf/NumbersEmptyError"}
{"name":"subOf-takes-two-values","query":"{:a 1} | subOf /a 1 1 !| tag","expect":"::any/subOf/ArgsBeyondInputsError"}
{"name":"subOf-given-one-value-is-refused","query":"{:a 1} | subOf /a !| tag","expect":"::any/subOf/SubtrahendNotGivenError"}
{"name":"the-verbs-of-one-subject-combine-numbers-under-the-tags-they-share","query":"{:a ::Cents#5 :b ::Dollars#2} | get [~(sumOf (get /a) (get /b) !| tag) ~(subOf /a /b !| tag) ~(mulOf (get /a) 3) ~(divOf /a 5)]","expect":"[::call/KindsMismatchedError ::call/KindsMismatchedError ::Cents#15 ::Cents#1]"}
{"name":"a-field-a-path-reads-for-a-verb-of-one-subject-is-held-to-its-kind-under-the-verb","query":"get [~({:price \"4\" :qty 3} | mulOf /price /qty !| get [~(tag) ~(factors | index) ~(factors | answer)]) ~({:total 10 :paid \"3\"} | subOf /total /paid !| get [~(tag) ~(subtrahend | answer)]) ~({:price \"10\" :tax 3} | sumOf /price /tax !| tag) ~({:sum 20 :count \"4\"} | divOf /sum /count !| tag)]","expect":"[[::any/mulOf/FactorsAnswerKindNotTakenError 0 \"4\"] [::any/subOf/SubtrahendAnswerKindNotTakenError \"3\"] ::any/sumOf/NumbersAnswerKindNotTakenError ::any/divOf/DivisorAnswerKindNotTakenError]"}
{"name":"a-divisor-of-zero-is-refused-under-divof","query":"{:sum 20 :count 0} | divOf /sum /count !| tag","expect":"::any/divOf/DivisorZeroError"}
{"name":"a-verb-of-one-subject-answers-under-the-tags-its-values-share-given-or-read","query":"{:a ::Cents#5 :b ::Cents#2 :c ::Dollars#2} | get [~(sumOf /a (get /b)) ~(mulOf (get /a) 3) ~(subOf /a (get /c) !| tag)]","expect":"[::Cents#7 ::Cents#15 ::call/KindsMismatchedError]"}
{"name":"a-field-a-path-misses-for-a-verb-of-one-subject-answers-the-refusal-of-its-read","query":"get [~({:total 10} | subOf /total /paid !| tag) ~({:paid 3} | subOf /total /paid !| tag) ~({:sum 20} | divOf /sum /count !| tag) ~({:count 4} | divOf /sum /count !| tag)]","expect":"[::path/KeyNotInMapError ::path/KeyNotInMapError ::path/KeyNotInMapError ::path/KeyNotInMapError]"}
