{"name":"a-set-literal-holds-its-elements-in-the-one-order","query":"#[3 1 3]","expect":"#[1 3]"}
{"name":"a-set-literal-of-mixed-kinds-orders-by-kind","query":"#[1 \"a\" null :k]","expect":"#[null 1 \"a\" :k]"}
{"name":"distinct-answers-the-set","query":"[1 2 1] | distinct | type","expect":"::set"}
{"name":"distinct-keeps-no-order-of-first-occurrence","query":"[2 1 2] | distinct | payload","expect":"[1 2]"}
{"name":"the-set-tag-runs-the-constructor-of-the-literal","query":"::set[3 1 3] | eq #[1 3]","expect":"true"}
{"name":"tag-set-runs-the-constructor","query":"[3 1 3] | tag ::set","expect":"#[1 3]"}
{"name":"the-payload-of-a-set-is-its-vector","query":"#[2 1] | payload","expect":"[1 2]"}
{"name":"the-set-tag-refuses-a-payload-other-than-a-vector","query":"::set{:a 1} !| type","expect":"::set/PayloadKindNotTakenError"}
{"name":"a-set-indexes-in-the-one-order","query":"#[:z :x :y] | query /1","expect":":y"}
{"name":"filter-keeps-the-set","query":"#[3 1 2] | filter ~(gt 1)","expect":"#[2 3]"}
{"name":"a-set-maps-into-the-vector-of-its-images","query":"#[-1 1] | map ~(mul 0)","expect":"[0 0]"}
{"name":"sort-of-a-set-answers-a-vector","query":"#[3 1 2] | sort | type","expect":"::vec"}
{"name":"reverse-of-a-set-answers-a-vector","query":"#[3 1 2] | reverse","expect":"[3 2 1]"}
{"name":"two-sets-are-equal-by-their-content","query":"#[1 2] | eq #[2 1]","expect":"true"}
{"name":"a-set-is-not-its-vector","query":"#[1 2] | eq [1 2]","expect":"false"}
{"name":"distinct","query":"[1 2 1 3 2 4] | distinct","expect":"#[1 2 3 4]"}
{"name":"distinct-on-set","query":"#[1 2 3] | distinct","expect":"#[1 2 3]"}
{"name":"set-literal","query":"#[1 2 3]","expect":"#[1 2 3]"}
{"name":"map-over-a-set-then-distinct","query":"#[1 2 3] | map ~(add 1) | distinct","expect":"#[2 3 4]"}
{"name":"a-set-answered-by-a-verb-that-keeps-its-subject-stays-a-set","query":"#[1 2 3] | filter ~(gt 1)","expect":"#[2 3]"}
{"name":"keys-answer-the-one-order","query":"{:b 1 :a 2} | keys | payload","expect":"[:a :b]"}
