{"name":"a-word-of-vectors-a-set-reaches-answers-a-set-each-value-held-once","query":"get [~(#[[1 1] [2 2]] | flat) ~(#[[1 1] [2 2]] | vec/zip) ~(#[[1 1] [2 2]] | zip)]","expect":"[#[1 2] #[[1 2]] [[1 2] [1 2]]]"}
