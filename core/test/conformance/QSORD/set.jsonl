{"name":"every-set-all-match","query":"#[2 4 6] | every ~(gt 0)","expect":"true"}
{"name":"every-set-one-fails","query":"#[2 4 -1] | every ~(gt 0)","expect":"false"}
{"name":"every-set-declared-verb","query":"#[2 4 6] | :any/big ~(gt 0) | every ~(big)","expect":"true"}
{"name":"every-set-verb-predicate","query":"#[2 4 6] | :any/positive ~(gt 0) | every ~positive","expect":"true"}
