{"name":"sort-takes-a-vector-as-a-compound-key","query":"[{:a 1 :b 2} {:a 1 :b 1} {:a 0 :b 9}] | sort ~(get [/a /b])","expect":"[{:a 0 :b 9} {:a 1 :b 1} {:a 1 :b 2}]"}
{"name":"sort-puts-nulls-last-through-a-key","query":"[3 null 1] | sort ~(get [~(eq null) ~(it)])","expect":"[1 3 null]"}
{"name":"sort-descends-through-reverse","query":"[{:k 1} {:k 3} {:k 2}] | sort /k | reverse","expect":"[{:k 3} {:k 2} {:k 1}]"}
{"name":"sort-keeps-equal-keys-in-subject-order","query":"[{:k 1 :i 0} {:k 0 :i 1} {:k 1 :i 2}] | sort /k","expect":"[{:k 0 :i 1} {:k 1 :i 0} {:k 1 :i 2}]"}
{"name":"sort-orders-keys-of-every-kind","query":"[{:k \"a\"} {:k null} {:k 2}] | sort /k","expect":"[{:k null} {:k 2} {:k \"a\"}]"}
{"name":"min-answers-the-first-value-in-the-order","query":"[3 \"a\" null] | min","expect":"null"}
{"name":"max-answers-the-last-value-in-the-order","query":"[3 \"a\" null] | max","expect":"\"a\""}
{"name":"a-key-that-answers-an-error-answers-it-over-a-map","query":"{:a {:n 1}} | sort /b !| type","expect":"::path/KeyNotInMapError"}
{"name":"a-vector-key-ranks-by-its-next-place-among-ties","query":"[{:a 1 :b 2} {:a 1 :b 1} {:a 0 :b 9}] | sort ~(get [/a /b]) | map /b","expect":"[9 1 2]"}
{"name":"a-place-of-a-key-that-fails-answers-the-call","query":"[{:a 2} {:b 1}] | sort ~(get [/a]) !| type","expect":"::path/KeyNotInMapError"}
{"name":"max-takes-a-key-and-answers-the-element","query":"[{:age 30} {:age 40}] | max /age","expect":"{:age 40}"}
{"name":"min-takes-a-key-and-answers-the-first-of-equal-ones","query":"[{:n 1 :i 0} {:n 1 :i 1}] | min /n | get /i","expect":"0"}
{"name":"the-key-of-the-greatest-value-of-a-map","query":"{:a 3 :b 1} | entries | max /1 | get /0","expect":":a"}
{"name":"a-key-of-max-that-fails-answers-the-call","query":"[{:a 2} {:b 1}] | max /a !| type","expect":"::path/KeyNotInMapError"}
{"name":"sort-by-key","query":"[{:age 30} {:age 20} {:age 25}] | sort /age","expect":"[{:age 20} {:age 25} {:age 30}]"}
{"name":"sort-by-string-key","query":"[{:name \"Bob\"} {:name \"Alice\"}] | sort /name","expect":"[{:name \"Alice\"} {:name \"Bob\"}]"}
{"name":"sort-by-key-orders-the-entries-by-what-the-key-answers","query":"{:a {:n 2} :b {:n 1}} | sort /n | vals | map /n","expect":"[1 2]"}
{"name":"a-key-of-a-sort-is-code-a-host-runs","query":"[{:a 2} {:a 1}] | sort /a | first | get /a","expect":"1"}
