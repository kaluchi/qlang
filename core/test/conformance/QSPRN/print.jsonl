{"name":"an-empty-line-doc-prints-as-an-empty-block","query":"|~~|\n| print","expect":"\"|~~  ~~|\""}
{"name":"a-trace-of-two-frames-prints-a-frame-a-line","query":"[1 \"x\" 3] | map ~(mul 2) !| trace | print","expect":"\"::trace[\\n  ::frame[\\\"x\\\" ~(mul 2)]\\n  ::frame[[1 \\\"x\\\" 3] ~(map ~(mul 2)) /1]\\n]\""}
{"name":"a-trace-of-one-frame-prints-on-one-line","query":"\"x\" | add 1 !| trace | print","expect":"\"::trace[::frame[\\\"x\\\" ~(add 1)]]\""}
