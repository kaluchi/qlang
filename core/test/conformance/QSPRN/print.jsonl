{"name":"true-prints-as-its-word","query":"true | print","expect":"\"true\""}
{"name":"false-prints-as-its-word","query":"false | print","expect":"\"false\""}
{"name":"null-prints-as-its-word","query":"null | print","expect":"\"null\""}
{"name":"an-empty-doc-prints-as-its-block","query":"|~~~~| | print","expect":"\"|~~  ~~|\""}
