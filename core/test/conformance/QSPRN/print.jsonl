{"name":"print-writes-an-atom-as-its-literal","query":"42 | print","expect":"\"42\""}
{"name":"print-writes-a-string-as-its-literal","query":"\"hi\" | print","expect":"\"\\\"hi\\\"\""}
{"name":"print-writes-a-descriptor-under-its-tag","query":"::builtin{:a 1} | print","expect":"\"::builtin{:a 1}\""}
{"name":"print-writes-a-doc-as-its-literal","query":"[\"a \" ~(add 1)] | tag ::doc | print","expect":"\"|~~a ~(add 1)~~|\""}
{"name":"print-writes-a-set-as-its-literal","query":"#[2 1] | print","expect":"\"#[1 2]\""}
{"name":"print-writes-a-quote-as-its-literal","query":"~(add 1) | print","expect":"\"~(add 1)\""}
{"name":"print-writes-each-part-by-its-kind","query":"[|~~ x ~~| #[1]] | print","expect":"\"[|~~ x ~~| #[1]]\""}
{"name":"the-print-of-a-value-reads-back-as-the-value","query":"{:a [1 \"x\" :k]} | :v it | print | parse | :q it | apply q | eq v","expect":"true"}
{"name":"a-doc-holding-a-quote-prints-as-written","query":"|~~ see ~(mul 2) for ref ~~| | print","expect":"\"|~~ see ~(mul 2) for ref ~~|\""}
{"name":"true-prints-as-its-word","query":"true | print","expect":"\"true\""}
{"name":"false-prints-as-its-word","query":"false | print","expect":"\"false\""}
{"name":"null-prints-as-its-word","query":"null | print","expect":"\"null\""}
{"name":"an-empty-doc-prints-as-its-block","query":"|~~~~| | print","expect":"\"|~~~~|\""}
{"name":"a-doc-of-prose-prints-as-its-block","query":"|~~ hello ~~| | print","expect":"\"|~~ hello ~~|\""}
{"name":"a-doc-of-several-lines-prints-them","query":"|~~\n  paragraph one\n  paragraph two\n~~| | print","expect":"\"|~~\\n  paragraph one\\n  paragraph two\\n~~|\""}
{"name":"a-line-doc-prints-as-a-block","query":"|~~| oneliner\n| print","expect":"\"|~~ oneliner~~|\""}
{"name":"an-empty-line-doc-prints-as-an-empty-block","query":"|~~|\n| print","expect":"\"|~~~~|\""}
{"decision":"D337","name":"a-trail-of-two-frames-prints-a-frame-a-line","query":"[1 \"x\" 3] | map ~(mul 2) !| trail | print","expect":"\"::trail[\\n  ::frame[\\\"x\\\" ~(mul 2)]\\n  ::frame[[1 \\\"x\\\" 3] ~(map ~(mul 2)) /1]\\n]\""}
{"decision":"D337","name":"a-trail-of-one-frame-prints-on-one-line","query":"\"x\" | add 1 !| trail | print","expect":"\"::trail[::frame[\\\"x\\\" ~(add 1)]]\""}
{"decision":"D337","name":"a-frame-prints-on-one-line-whatever-its-subject-holds","query":"{:v [{:e {:f 1}}] :s #[{:c {:d 1}}] :t ::A::B{:g {:h 1}} :r !{:i {:j 1}}} | get /none !| trail | print","expect":"\"::trail[::frame[{:v [{:e {:f 1}}] :s #[{:c {:d 1}}] :t ::A::B{:g {:h 1}} :r !{:i {:j 1}}} ~(get /none)]]\""}
{"decision":"D337","name":"a-frame-prints-the-trail-of-an-error-it-holds-on-its-one-line","query":"[1 \"x\" 3] | map ~(mul 2) !| get /nope !| trail | print","expect":"\"::trail[::frame[::number/mul/SubjectNotNumberError!{:actualType ::string :trail ::trail[::frame[\\\"x\\\" ~(mul 2)] ::frame[[1 \\\"x\\\" 3] ~(map ~(mul 2)) /1]]} ~(get /nope)]]\""}
