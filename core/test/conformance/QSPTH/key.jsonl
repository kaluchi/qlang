{"name":"get-reads-a-key-the-query-computes","query":"{:k \"b\" :b 7} | get (get /k)","expect":"7"}
{"name":"a-key-with-a-slash-is-read-by-its-keyword","query":"{:a/b 1} | get :a/b","expect":"1"}
{"name":"a-path-parts-its-segments-at-each-slash","query":"{:a/b 1} | get /a/b !| type","expect":"::path/KeyNotInMapError"}
{"name":"query-map-string-key","query":"{:a 1 :b 2 :c 3} | query \"b\"","expect":"2"}
{"name":"query-map-dynamic-keyword-key","query":"{:x 42} | :m it | (:x | :k it | m | query k)","expect":"42"}
{"name":"query-map-dynamic-string-key","query":"{:x 42} | :m it | (\"x\" | :k it | m | query k)","expect":"42"}
{"name":"query-json-object-string-key","query":"::json{:a 1 :b 2 :c 3} | query \"b\"","expect":"2"}
{"name":"keys-then-query-roundtrip-map","query":":src {:a 1 :b 2} | src | keys | first | :k it | src | query k","expect":"1"}
{"name":"minus-reads-a-string-as-a-key","query":"{:a 1 :b 2} | minus [\"a\"]","expect":"{:b 2}"}
{"name":"inter-reads-a-string-as-a-key","query":"{:a 1 :b 2 :c 3} | inter #[\"a\" :c]","expect":"{:a 1 :c 3}"}
{"name":"minus-refuses-an-element-that-names-no-key","query":"{:a 1} | minus [:a true] !| get [~(type) /index]","expect":"[::map/minus/keys/ElementKindNotTakenError 1]"}
{"name":"query-index-not-integer-error","query":"[1 2 3] | query 0.5 !| type","expect":"::path/IndexNotIntegerError"}
{"name":"a-value-given-as-a-key-that-is-no-key-is-a-template","query":"{:email {:home \"a@b\"}} | query (get /email)","expect":"{:home \"a@b\"}"}
{"name":"inter-refuses-a-single-key-and-a-key-of-another-kind","query":"get [~({:a 1} | inter :a !| type) ~({:a 1} | inter [true] !| type)]","expect":"[::map/inter/keys/KindNotTakenError ::map/inter/keys/ElementKindNotTakenError]"}
{"name":"a-number-names-the-key-of-its-text-in-minus-and-inter","query":"{:\"1\" 5 :b 2} | get [~(minus [1]) ~(inter [1]) ~([{:\"1\" 5 :b 2} [1]] | minus)]","expect":"[{:b 2} {:\"1\" 5} {:b 2}]"}
{"name":"get-and-query-refuse-a-value-that-names-no-part","query":"{:true 1 :k null :f true} | get [~(get (get /k) !| type) ~(get (get /f) !| type) ~(query #\"a\" !| type) ~(get ::a !| type)]","expect":"[::any/get/path/KindNotTakenError ::any/get/path/KindNotTakenError ::any/query/path/KindNotTakenError ::any/get/path/KindNotTakenError]"}
{"name":"get-reads-a-set-a-value-under-a-tag-and-a-quote-as-templates","query":"{:a 1} | get [~(get #[/a]) ~(get ::Box[/a]) ~(get ~(get /a)) ~(get !{:x /a})]","expect":"[#[1] ::Box[1] 1 !{:x 1}]"}
{"name":"a-key-a-modifier-failed-to-compute-answers-its-failure","query":"{} | get (get /k) !| type","expect":"::path/KeyNotInMapError"}
{"name":"the-group-of-a-boolean-is-read-by-its-keyword","query":"[1 2 3] | groupBy ~(gt 1) | get [~(get true !| type) ~(get :true)]","expect":"[::any/get/path/KindNotTakenError [2 3]]"}
{"name":"get-and-query-read-a-key-beneath-its-tags-and-a-path-under-a-tag-as-a-template","query":"{:a 1} | get [~(get ::K:a) ~(query ::K:b 7) ~(has ::K:a) ~(get ::T#/a)]","expect":"[1 7 true ::T#1]"}
