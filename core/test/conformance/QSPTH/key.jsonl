{"name":"a-number-names-the-key-of-its-text-in-minus-and-inter","query":"{:\"1\" 5 :b 2} | get [(minus [1]) (inter [1]) ([{:\"1\" 5 :b 2} [1]] | minus)]","expect":"[{:b 2} {:\"1\" 5} {:b 2}]"}
