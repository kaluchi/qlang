{"name":"get-runs-the-quotes-of-its-template","query":"{:first \"Ann\" :age 30} | get {:who /first :next ~(get /age | add 1)}","expect":"{:who \"Ann\" :next 31}"}
{"name":"a-template-held-in-a-name-builds-the-shape-of-each-element","query":":view {:who /first :n ~(get /tags | count)} | [{:first \"A\" :tags [1 2]} {:first \"B\" :tags []}] | map ~(get view)","expect":"[{:who \"A\" :n 2} {:who \"B\" :n 0}]"}
{"name":"query-reads-the-paths-of-its-template-softly","query":"{:a 1} | query [~(get /a) /b]","expect":"[1 null]"}
{"name":"a-template-reads-under-a-tag-runs-a-quote-and-answers-a-doc","query":"{:a 1} | get [/a ::Box[/a] ::Box#5 |~~ x ~~| ~(get /a) #[/a 2]]","expect":"[1 ::Box[1] ::Box#5 |~~ x ~~| 1 #[1 2]]"}
{"name":"a-template-lays-a-tag-back-through-its-kind","query":":P |~~ P. ~~| (::kind | holds :HasNumberError |~~ No number. ~~| ~(every ~(type | ne ::number))) | {:a 1} | get [::P[/a]] !| type","expect":"::P/HasNumberError"}
{"name":"a-template-answers-a-function-as-it-is","query":"get [::fn[~(takes :by |~~ How much. ~~| /0) ~(add by)]] | first | type !| type","expect":"::fn"}
{"name":"a-template-answers-a-kind-as-it-is","query":"get [::kind[~(wraps |~~ A number. ~~| ::number) null]] | first | type !| type","expect":"::kind"}
{"name":"get-reads-a-tuple","query":"{:price 4 :qty 3} | get [/price /qty]","expect":"[4 3]"}
{"name":"get-reads-a-template","query":"{:first \"Ann\" :tags [:a :b]} | get {:who /first :n ~(get /tags | count)}","expect":"{:who \"Ann\" :n 2}"}
{"name":"query-reads-a-tuple-softly","query":"{:a 1} | query [/a /b]","expect":"[1 null]"}
{"name":"get-reads-a-template-strictly","query":"{:a 1} | get [/a /b] !| type","expect":"::path/KeyNotInMapError"}
{"name":"a-set-template-reads-its-paths","query":"{:name \"Alice\" :age 30} | get #[/name /age]","expect":"#[30 \"Alice\"]"}
{"name":"if-inside-a-template","query":"[{:n 5} {:n 15}] | map ~(get {:value /n :tier ~(if (get /n | gt 10) ~(\"high\") ~(\"low\"))})","expect":"[{:value 5 :tier \"low\"} {:value 15 :tier \"high\"}]"}
{"name":"a-failed-part-answers-the-template-before-a-step-after-it","query":"get [1 ~(\"x\" | add 1)] | map ~(0) !| type","expect":"::number/add/SubjectNotNumberError"}
{"name":"a-template-reads-beneath-every-tag-over-it","query":"{:a 1} | get [::Box::Crate[/a] ::Box#[/a]]","expect":"[::Box::Crate[1] ::Box#[1]]"}
{"name":"a-template-beneath-tags-answers-the-failure-of-a-part","query":"{:a 1} | get ::Box::Crate[/zz] !| type","expect":"::path/KeyNotInMapError"}
{"name":"an-atom-under-a-tag-in-a-template-is-answered-as-it-is","query":"{:a 1} | get [::Box#5 ::Box\"s\"]","expect":"[::Box#5 ::Box\"s\"]"}
{"name":"a-template-under-three-tags-is-read","query":"{:a 1} | get ::A::B::C[/a]","expect":"::A::B::C[1]"}
{"name":"a-set-under-a-tag-in-a-template-answers-the-failure-of-a-part","query":"{:a 1} | get ::Box#[~(1 | add \"x\")] !| type","expect":"::number/add/addend/KindNotTakenError"}
{"name":"a-quote-in-a-set-under-a-tag-runs-as-every-quote-of-a-template","query":":k 2 | 1 | get ::Box#[~(add k)]","expect":"::Box#[3]"}
{"name":"a-field-of-a-kind-that-takes-a-number-refuses-a-path","query":":Box |~~ B ~~| (::kind | reads :w |~~ w ~~| /w ::number) | {:w 1} | get [::Box{:w /w}] !| type","expect":"::Box/w/KindNotTakenError"}
