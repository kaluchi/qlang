{"name":"a-number-literal-read-by-parse-opens-to-the-number","query":"\"42\" | parse | answer","expect":"42"}
{"name":"a-string-literal-read-by-parse-opens-to-the-string","query":"\"\\\"hello\\\"\" | parse | answer","expect":"\"hello\""}
{"name":"a-keyword-literal-read-by-parse-opens-to-the-keyword","query":"\":foo\" | parse | answer","expect":":foo"}
{"name":"a-vector-literal-read-by-parse-opens-to-the-vector","query":"\"[1 2 3]\" | parse | answer","expect":"[1 2 3]"}
{"name":"a-map-literal-read-by-parse-opens-to-the-map","query":"\"{:a 1 :b 2}\" | parse | answer","expect":"{:a 1 :b 2}"}
{"name":"a-set-literal-read-by-parse-opens-to-the-set","query":"\"#[1 2 3]\" | parse | answer","expect":"#[1 2 3]"}
{"name":"a-source-that-starts-from-a-number-opens-to-its-answer","query":"\"10 | add 5\" | parse | answer","expect":"15"}
{"name":"a-source-that-filters-and-counts-a-vector-opens-to-the-count","query":"\"[1 2 3 4 5] | filter (gt 2) | count\" | parse | answer","expect":"3"}
{"name":"a-source-that-reads-a-field-of-its-map-opens-to-the-field","query":"\"{:name \\\"alice\\\" :age 30} | get /name\" | parse | answer","expect":"\"alice\""}
{"name":"a-source-that-maps-its-vector-opens-to-the-images","query":"\"[1 2 3] | map (add 10)\" | parse | answer","expect":"[11 12 13]"}
{"name":"a-source-that-catches-its-own-failure-opens-to-the-catch","query":"\"\\\"hello\\\" | add 1 !| tag\" | parse | answer","expect":"::number/add/SubjectNotNumberError"}
{"name":"apply-refuses-a-number-for-its-code-naming-the-kinds-it-takes","query":"42 | apply 42","raises":"::any/apply/CodeKindNotTakenError!{:subject/found 42 :code/expected #[::fn ::path ::quote] :code/found 42 :trace ::trace[::frame[42 ~(apply 42)]]}"}
{"name":"apply-runs-a-quote-against-its-subject","query":"5 | apply (mul 2)","expect":"10"}
{"name":"apply-refuses-a-value-of-another-kind-naming-its-kind","query":"42 | apply 1 !| get [tag (code | found | tag)]","expect":"[::any/apply/CodeKindNotTakenError ::number]"}
{"name":"apply-keeps-declarations-inside","query":"1 | apply (:x 2;) | x !| tag","expect":"::call/UnknownNameError"}
{"name":"apply-runs-a-pipeline-quote-against-the-subject","query":"5 | apply (add 1 | mul 2)","expect":"12"}
{"name":"apply-takes-code-and-refuses-a-number-under-its-input","query":"5 | apply 3 !| tag","expect":"::any/apply/CodeKindNotTakenError"}
{"name":"a-value-that-is-no-quote-is-refused-by-the-address-of-answer","query":"5 | quote/answer !| tag","expect":"::quote/answer/SubjectNotQuoteError"}
{"name":"answer-lives-on-the-kind-of-a-quote","query":"::quote | manifest | has ::quote/answer","expect":"true"}
{"name":"a-print-reads-back-by-parse-and-answer","query":"{:price 4 :qty 3} | print | parse | answer","expect":"{:price 4 :qty 3}"}
{"name":"the-args-of-apply-are-a-vector","query":"5 | apply it 7 !| tag","expect":"::any/apply/ArgsKindNotTakenError"}
{"name":"a-path-applied-takes-no-args","query":"{:a 1} | apply /a [1] !| tag","expect":"::any/apply/ArgsNotTakenError"}
{"name":"open-runs-a-quote-from-null","query":"~(it) | answer","expect":"null"}
