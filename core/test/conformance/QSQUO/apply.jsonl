{"name":"a-number-literal-read-by-parse-opens-to-the-number","query":"\"42\" | parse | open","expect":"42"}
{"name":"a-string-literal-read-by-parse-opens-to-the-string","query":"\"\\\"hello\\\"\" | parse | open","expect":"\"hello\""}
{"name":"a-keyword-literal-read-by-parse-opens-to-the-keyword","query":"\":foo\" | parse | open","expect":":foo"}
{"name":"a-vector-literal-read-by-parse-opens-to-the-vector","query":"\"[1 2 3]\" | parse | open","expect":"[1 2 3]"}
{"name":"a-map-literal-read-by-parse-opens-to-the-map","query":"\"{:a 1 :b 2}\" | parse | open","expect":"{:a 1 :b 2}"}
{"name":"a-set-literal-read-by-parse-opens-to-the-set","query":"\"#[1 2 3]\" | parse | open","expect":"#[1 2 3]"}
{"name":"a-source-that-starts-from-a-number-opens-to-its-answer","query":"\"10 | add 5\" | parse | open","expect":"15"}
{"name":"a-source-that-filters-and-counts-a-vector-opens-to-the-count","query":"\"[1 2 3 4 5] | filter ~(gt 2) | count\" | parse | open","expect":"3"}
{"name":"a-source-that-reads-a-field-of-its-map-opens-to-the-field","query":"\"{:name \\\"alice\\\" :age 30} | get /name\" | parse | open","expect":"\"alice\""}
{"name":"a-source-that-maps-its-vector-opens-to-the-images","query":"\"[1 2 3] | map ~(add 10)\" | parse | open","expect":"[11 12 13]"}
{"name":"a-source-that-catches-its-own-failure-opens-to-the-catch","query":"\"\\\"hello\\\" | add 1 !| tag\" | parse | open","expect":"::number/add/SubjectNotNumberError"}
{"name":"apply-refuses-a-number-for-its-code-naming-the-kinds-it-takes","query":"42 | apply it","raises":"::any/apply/code/KindNotTakenError!{:expected #[::fn ::path ::quote] :actualTag ::number :actualValue 42 :trace ::trace[::frame[42 ~(apply it)]]}"}
{"name":"apply-runs-a-quote-against-its-subject","query":"5 | apply ~(mul 2)","expect":"10"}
{"name":"apply-refuses-a-value-of-another-kind-naming-its-kind","query":"42 | apply 1 !| get [~(tag) /actualTag]","expect":"[::any/apply/code/KindNotTakenError ::number]"}
{"name":"apply-keeps-declarations-inside","query":"1 | apply ~(:x 2) | x !| tag","expect":"::call/UnknownNameError"}
{"name":"apply-runs-a-pipeline-quote-against-the-subject","query":"5 | apply ~(add 1 | mul 2)","expect":"12"}
{"name":"apply-takes-code-and-refuses-a-number-under-its-input","query":"5 | apply 3 !| tag","expect":"::any/apply/code/KindNotTakenError"}
{"name":"a-value-that-is-no-quote-opens-nothing","query":"5 | open !| tag","expect":"::quote/open/SubjectNotQuoteError"}
{"name":"open-lives-on-the-kind-of-a-quote","query":"::quote | manifest | has ::quote/open","expect":"true"}
{"name":"the-args-of-apply-are-a-vector","query":"5 | apply ~(it) 7 !| tag","expect":"::any/apply/args/KindNotTakenError"}
{"name":"a-path-applied-takes-no-args","query":"{:a 1} | apply /a [1] !| tag","expect":"::any/apply/args/NotTakenError"}
