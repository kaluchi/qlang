{"name":"a-quote-of-a-number-is-a-value-as-written","query":"~(42)","expect":"~(42)"}
{"name":"a-quote-of-a-call-is-a-value-as-written","query":"~(mul 2)","expect":"~(mul 2)"}
{"name":"a-quote-of-a-pipeline-that-holds-a-quote-is-a-value-as-written","query":"~([1 2 3] | eq ~(gt 1))","expect":"~([1 2 3] | eq ~(gt 1))"}
{"name":"a-quote-of-a-read-by-get-is-a-value-as-written","query":"~(get /name)","expect":"~(get /name)"}
{"name":"the-empty-quote-is-a-value-as-written","query":"~()","expect":"~()"}
{"name":"a-quote-of-a-keyword-is-a-value-as-written","query":"~(:foo)","expect":"~(:foo)"}
{"name":"a-quote-of-a-literal-across-lines-is-a-value-as-written","query":"~({\n  :a 1\n  :b 2\n})","expect":"~({\n  :a 1\n  :b 2\n})"}
{"name":"a-quote-whose-content-reads-as-no-pipeline-is-refused","query":"\"~( , )\" | parse !| tag","expect":"::quote/ParseError"}
{"name":"the-tag-of-a-quote-is-quote","query":"~(mul 2) | tag | eq ::quote","expect":"true"}
{"name":"two-quotes-of-the-same-steps-are-equal","query":"~(mul 2) | eq ~(mul 2)","expect":"true"}
{"name":"two-quotes-of-different-steps-differ","query":"~(mul 2) | eq ~(mul 3)","expect":"false"}
{"name":"quote-equality-ignores-spacing","query":"~(mul 2) | eq ~(mul  2)","expect":"true"}
{"name":"quote-equality-ignores-comments","query":"~(mul 2 |~ note ~|) | eq ~(mul 2)","expect":"true"}
{"name":"a-quote-is-not-equal-to-the-string-of-its-text","query":"~(mul 2) | eq \"mul 2\"","expect":"false"}
{"name":"a-vector-holds-quotes-as-its-elements","query":"[~(a) ~(b) ~(c)] | count","expect":"3"}
{"name":"a-quote-in-a-vector-writes-the-text-of-its-code","query":"[~(a) ~(b) ~(c)] | first | toString","expect":"\"a\""}
{"name":"a-quote-in-a-map-writes-the-text-of-its-code","query":"{:body ~(mul 2)} | get /body | toString","expect":"\"mul 2\""}
{"name":"a-set-holds-quotes-as-its-elements","query":"#[~(a) ~(b)] | count","expect":"2"}
{"name":"a-short-quote-is-the-quote-of-its-word","query":"~add","expect":"~(add)"}
