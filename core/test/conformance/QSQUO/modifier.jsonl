{"name":"a-modifier-reads-the-subject-of-its-own-step","query":"{:qty 2 :price 3} | get /qty | mul (get /price) !| type","expect":"::path/SubjectHasNoPartsError"}
{"name":"a-group-modifier-reads-against-the-subject-at-the-call","query":"{:items [1 2 3] :limit 2} | get /items | take (count | sub 1)","expect":"[1 2]"}
{"name":"apply-code-that-fails-is-refused-by-its-input","query":"5 | apply (get /nope) !| get [~(type) /actualType]","expect":"[::any/apply/code/KindNotTakenError ::path/SubjectHasNoPartsError]"}
{"name":"a-step-without-its-quote-is-refused-by-the-input-of-code","query":"[{:a true}] | filter (get /a) !| get [~(type) /actualType]","expect":"[::vec/filter/predicate/KindNotTakenError ::path/IndexNotIntegerError]"}
{"name":"an-input-of-code-of-a-reader-refuses-a-failed-modifier","query":":any/f (::fn | takes :q |~~ The q. ~~| /0 ::quote | impl ~(apply q)) | 1 | f (get /x) !| type","expect":"::any/f/q/KindNotTakenError"}
{"name":"an-input-of-a-value-passes-a-failed-modifier-as-it-is","query":"[1 2] | take (get /x) !| type","expect":"::path/IndexNotIntegerError"}
{"name":"each-modifier-forks-against-the-subject-its-result-by-position","query":":any/pair (::fn | takes :a |~~ The a. ~~| /0 | takes :b |~~ The b. ~~| /1 | impl ~(get [~(a) ~(b)])) | 5 | pair (add 1) (mul 2)","expect":"[6 10]"}
{"name":"a-modifier-sees-no-name-another-declared","query":":any/pair (::fn | takes :a |~~ The a. ~~| /0 | takes :b |~~ The b. ~~| /1 | impl ~(get [~(a) ~(b)])) | 5 | pair (:y 1 | y) y !| type","expect":"::call/UnknownNameError"}
{"name":"a-modifier-of-a-built-in-forks-against-the-subject","query":"10 | add (sub 3)","expect":"17"}
