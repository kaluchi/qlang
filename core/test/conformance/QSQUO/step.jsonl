{"name":"map-reaches-the-quote-beneath-a-tag","query":"::Box~(add 1 | mul 2) | map ~type","expect":"[::call ::call]"}
{"name":"quote-count-counts-steps","query":"~(1 | add 1 | mul 2) | count","expect":"3"}
{"name":"quote-payload-is-its-steps","query":"~(filter ~(gt 1)) | payload","expect":"[::call{:name :filter :modifiers [~(gt 1)]}]"}
{"name":"quote-projects-its-steps-by-index","query":"~(mul 2) | get /0 | get /name","expect":":mul"}
{"name":"quote-step-of-a-call-is-a-call-record","query":"~(mul 2) | first | type","expect":"::call"}
{"name":"a-step-on-each-element-is-a-call","query":"~(map ~inc | sort) | first | get [~(type) /name]","expect":"[::call :map]"}
{"name":"quote-comment-leaves-no-step","query":"~(|~ note ~| count) | count","expect":"1"}
{"name":"quote-filter-keeps-a-quote","query":"~(add 1 | mul 2) | filter ~(get /name | eq :mul)","expect":"~(mul 2)"}
{"name":"map-over-a-quote-drops-the-tag","query":"~(add 1 | mul 2) | map /name","expect":"[:add :mul]"}
{"name":"quote-tag-refuses-a-non-step","query":"[::Box[1]] | tag ::quote !| type","expect":"::quote/ElementNotStepError"}
{"name":"quote-assembled-from-steps","query":"[[1 2] ::call{:name :count}] | tag ::quote | parse","expect":"\"[1 2] | count\""}
{"name":"call-record-that-reads-back-as-no-code-is-refused","query":"::call{:name :\"a b\"} !| get [~(type) /printed]","expect":"[::call/ReadBackDiffersError \"a b\"]"}
{"name":"the-step-of-a-constructor-is-a-construct","query":"~(::Box[1 2]) | first | type","expect":"::construct"}
{"name":"a-construct-step-over-an-error-literal-step-reads-back-as-another","query":"~(!{:k 1}) | get {:tag ::Foo :payload /0} | tag ::construct !| type","expect":"::construct/ReadBackDiffersError"}
{"name":"the-kind-of-tagged-values-is-no-step","query":"::tagged | doc | content | contains \"A value under a tag\"","expect":"true"}
