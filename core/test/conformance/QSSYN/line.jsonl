{"name":"vec-across-lines","query":"[\n  1\n  2\n  3\n]","expect":"[1 2 3]"}
{"name":"map-across-lines","query":"{\n  :name \"Alice\"\n  :age 30\n}","expect":"{:name \"Alice\" :age 30}"}
{"name":"pipeline-across-lines","query":"[1 2 3 4 5]\n  | filter ~(gt 2)\n  | count","expect":"3"}
{"name":"with-line-comments","query":"|~| compute the sum\n| [1 2 3]\n  | sum |~| final reduction","expect":"6"}
{"name":"deeply-nested-multiline","query":"{\n  :team {\n    :lead {\n      :name \"Alice\"\n      :email \"alice@example.com\"\n    }\n  }\n} | get /team/lead/email","expect":"\"alice@example.com\""}
{"name":"a-literal-across-lines-continues-its-pipeline","query":"[\n  {:price 100 :qty 3}\n  {:price 50 :qty 10}\n]\n  | map ~(mulOf /price /qty)","expect":"[300 500]"}
{"name":"steps-a-line-alone-joins-do-not-parse","query":"\"[3 1 2]\nsort\" | parse | count !| type","expect":"::quote/ParseError"}
{"name":"a-command-takes-its-modifiers-across-lines-at-the-top-level","query":"\"5 | if (gt 0)\n  ~(\\\"pos\\\")\n  ~(\\\"neg\\\")\" | parse | apply it !| type","expect":"\"pos\""}
{"name":"a-command-takes-its-modifiers-across-lines-inside-brackets","query":"5 | apply (\"(if (gt 0)\n  ~(\\\"pos\\\")\n  ~(\\\"neg\\\"))\" | parse)","expect":"\"pos\""}
{"name":"a-declaration-on-the-next-line-ends-a-command-body","query":"\"[1 2] | :x take 1\n:y 2\n| get [~(x) ~(y)]\" | parse | apply it","expect":"[[1] 2]"}
{"name":"a-tag-name-on-a-later-line-is-the-body","query":":s\n::vec\n| s","expect":"::vec"}
{"name":"a-tag-name-on-a-later-line-is-the-body-of-its-declaration","query":":Box |~~ A box. ~~| | :Box/w\n  ::number | ::Box/w | binding | get /value","expect":"::number"}
{"name":"a-keyword-on-a-later-line-opens-a-declaration-of-its-own","query":":a\n:b 2\n| b","expect":"2"}
