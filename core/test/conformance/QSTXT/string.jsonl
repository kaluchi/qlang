{"name":"prepend","query":"\"world\" | prepend \"hello \"","expect":"\"hello world\""}
{"name":"append","query":"\"hello\" | append \" world\"","expect":"\"hello world\""}
{"name":"prepend-empty","query":"\"x\" | prepend \"\"","expect":"\"x\""}
{"name":"append-empty","query":"\"x\" | append \"\"","expect":"\"x\""}
{"name":"prepend-non-string","query":"42 | prepend \"x\"","expect":"::call/KindAnswersNoVerbError!{\n  :name :prepend\n  :addresses #[::string/prepend ::vec/prepend]\n  :actualType ::number\n  :trail [\n    {\n      :step ~(prepend \"x\")\n      :subject 42\n      :skipped ~()\n    }\n  ]\n} | raise"}
{"name":"append-non-string","query":"42 | append \"x\"","expect":"::call/KindAnswersNoVerbError!{\n  :name :append\n  :addresses #[::string/append ::vec/append]\n  :actualType ::number\n  :trail [\n    {\n      :step ~(append \"x\")\n      :subject 42\n      :skipped ~()\n    }\n  ]\n} | raise"}
{"name":"lower-folds-the-case-of-a-string","query":"\"Ann@Example.COM\" | lower","expect":"\"ann@example.com\""}
{"name":"upper-raises-the-case-of-a-string","query":"\"ok, go\" | upper","expect":"\"OK, GO\""}
{"name":"strings-that-differ-in-case-alone-meet-once-lowered","query":"[\"Ann\" \"ANN\" \"bob\"] | map ~lower | distinct | count","expect":"2"}
{"name":"lower-refuses-a-subject-that-is-no-string","query":"42 | lower !| type","expect":"::string/lower/SubjectNotStringError"}
{"name":"a-string-counts-its-characters","query":"\"привет\" | count","expect":"6"}
{"name":"a-string-takes-its-first-characters","query":"\"db_host\" | take 2","expect":"\"db\""}
{"name":"a-string-drops-its-first-characters","query":"\"db_host\" | drop 3","expect":"\"host\""}
{"name":"a-string-reads-in-pieces-by-its-lines","query":"\"a\\nb\\nc\" | lines | drop 1 | take 1","expect":"[\"b\"]"}
{"name":"trim-cuts-the-whitespace-at-both-ends","query":"\"  db_host \n\" | trim","expect":"\"db_host\""}
{"name":"prepend-modifier-not-string","query":"\"x\" | prepend 42","expect":"::string/prepend/prefix/KindNotTakenError!{\n  :expected #[::keyword ::string]\n  :actualValue 42\n  :actualType ::number\n  :trail [\n    {\n      :step ~(prepend 42)\n      :subject \"x\"\n      :skipped ~()\n    }\n  ]\n} | raise"}
{"name":"append-modifier-not-string","query":"\"x\" | append 42","expect":"::string/append/suffix/KindNotTakenError!{\n  :expected #[::keyword ::string]\n  :actualValue 42\n  :actualType ::number\n  :trail [\n    {\n      :step ~(append 42)\n      :subject \"x\"\n      :skipped ~()\n    }\n  ]\n} | raise"}
{"name":"lines-reads-a-carriage-return-and-drops-the-last-break","query":"\"a\\r\\nb\\r\\n\" | lines","expect":"[\"a\" \"b\"]"}
{"name":"a-string-counts-its-code-points","query":"\"e\\u0301\" | count","expect":"2"}
{"name":"case-folds-as-unicode-maps-the-text","query":"get [~(\"ΣΑΣ\" | lower) ~(\"straße\" | upper)]","expect":"[\"σας\" \"STRASSE\"]"}
{"name":"an-empty-text-has-no-lines","query":"\"\" | lines","expect":"[]"}
{"name":"append-and-prepend-write-a-keyword-as-its-name","query":"\"x\" | get [~(prepend :a) ~(append :a)]","expect":"[\"ax\" \"xa\"]"}
{"decision":"D321","name":"size-and-length-answer-as-count-over-a-string","query":"\"привет\" | get [~(size) ~(length) ~(count)]","expect":"[6 6 6]"}
