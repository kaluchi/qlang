{"name":"a-link-opens-to-the-answer-of-its-query","query":"|~~ ::link~(1 | add 1) ~~| | links | first | open","expect":"2","decision":"D111"}
{"name":"open-lives-on-the-kind-of-a-quote","query":"::quote | spec | /verbs | has ::quote/open","expect":"true","decision":["D111","D122"]}
{"name":"a-concept-is-a-member-of-the-root-noun","query":"::qlang | doc :pipeline | type","expect":"::doc","decision":["D111","D117","D119"]}
{"name":"the-first-screen-opens-every-page-it-names-in-one-query","query":"::qlang | doc | links * open | every ~(false !| true | not)","expect":"true","decision":["D111","D119"]}
{"name":"the-first-screen-names-the-concepts","query":"::qlang | doc | links * open | filter ~(type | eq ::doc) | count | gt 5","expect":"true","decision":["D111","D119"]}
{"name":"a-member-of-a-noun-is-no-name-a-query-calls","query":"5 | pipeline !| type","expect":"::UnresolvedIdentifierError","decision":"D117"}
{"name":"a-path-of-anchors-reads-the-page-of-a-slot","query":"::vec | doc [:take :count] | eq null","expect":"true","decision":"D119"}
{"name":"a-set-of-anchors-reads-several-pages","query":"::qlang | doc #[:pipeline :errors] | count","expect":"2","decision":"D119"}
{"name":"a-member-of-the-root-has-no-address-of-its-own","query":"::qlang/pipeline | doc !| type","expect":"::DocBindingNotFoundError","decision":"D119"}
{"name":"docs-leaves-for-doc","query":"5 | docs | type !| type","expect":"::UnresolvedIdentifierError","decision":"D119"}
