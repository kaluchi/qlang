{"name":"indexBy-non-keyword-key-throws","query":"[{:k 1}] | indexBy ~(/k)","error":"typeError","expect":"::IndexByKeyNotKeywordError!{\n  :actualValue 1\n  :actualType ::number\n  :index 0\n  :trail [\n    {\n      :step ~(indexBy ~(/k))\n      :subject [{:k 1}]\n      :skipped ~()\n    }\n  ]\n}"}
