{"name":"duplicate-keys-last-wins","query":"[{:id :a :v 1} {:id :a :v 2}] | indexBy ~(/id) | /a/v","expect":"2","decision":"D18"}
{"name":"indexBy-empty-vec-yields-empty-map","query":"[] | indexBy ~(/k) | empty","expect":"true"}
