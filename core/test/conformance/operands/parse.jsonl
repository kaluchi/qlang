{"name":"parse-number-literal","query":"\"42\" | parse","expect":"~(42)"}
{"name":"parse-number-literal-step","query":"\"42\" | parse | first","expect":"42"}
{"name":"parse-string-literal-step","query":"\"\\\"hello\\\"\" | parse | first","expect":"\"hello\""}
{"name":"parse-keyword-literal-step","query":"\":foo\" | parse | first","expect":":foo"}
{"name":"parse-operand-call-name","query":"\"add 1 2\" | parse | first | /name","expect":":add"}
{"name":"parse-operand-call-args-count","query":"\"add 1 2\" | parse | first | /args | count","expect":"2"}
{"name":"parse-command-modifiers-are-their-steps","query":"\"add 1 2\" | parse | first | /args","expect":"[1 2]"}
{"name":"parse-bare-operand-has-no-args","query":"\"count\" | parse | first | has :args","expect":"false"}
{"name":"parse-projection-path","query":"\"/a/b/0\" | parse | first | /path","expect":"[:a :b 0]"}
