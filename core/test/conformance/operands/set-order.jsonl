{"name":"a-set-literal-holds-its-elements-in-the-one-order","query":"#[3 1 3]","expect":"#[1 3]"}
{"name":"a-set-literal-of-mixed-kinds-orders-by-kind","query":"#[1 \"a\" null :k]","expect":"#[null 1 \"a\" :k]"}
{"name":"distinct-answers-the-set","query":"[1 2 1] | distinct | type","expect":"::set"}
{"name":"distinct-keeps-no-order-of-first-occurrence","query":"[2 1 2] | distinct | payload","expect":"[1 2]"}
{"name":"the-set-tag-runs-the-constructor-of-the-literal","query":"::set[3 1 3] | eq #[1 3]","expect":"true"}
{"name":"tag-set-runs-the-constructor","query":"[3 1 3] | tag ::set","expect":"#[1 3]"}
{"name":"the-payload-of-a-set-is-its-vector","query":"#[2 1] | payload","expect":"[1 2]"}
{"name":"the-set-tag-refuses-a-payload-other-than-a-vector","query":"::set{:a 1} !| type","expect":"::SetPayloadNotVecError"}
{"name":"a-set-joins-as-the-vector-it-is","query":"#[\"b\" \"a\"] | join \",\"","expect":"\"a,b\""}
{"name":"a-set-indexes-in-the-one-order","query":"#[:z :x :y] | at 1","expect":":y"}
{"name":"filter-keeps-the-set","query":"#[3 1 2] | filter ~(gt 1)","expect":"#[2 3]"}
{"name":"a-set-distributes-into-the-set-of-its-images","query":"#[-1 1] * mul 0","expect":"#[0]"}
{"name":"flat-of-sets-is-their-union","query":"#[#[3 1] #[2 1]] | flat","expect":"#[1 2 3]"}
{"name":"sort-of-a-set-answers-a-vector","query":"#[3 1 2] | sort | type","expect":"::vec"}
{"name":"reverse-of-a-set-answers-a-vector","query":"#[3 1 2] | reverse","expect":"[3 2 1]"}
{"name":"has-finds-a-composite-member","query":"#[{:a 2} [1] \"x\" 3] | has [1]","expect":"true"}
{"name":"has-misses-a-value-between-two-members","query":"#[1 3 5] | has 4","expect":"false"}
{"name":"union-merges-two-sets-of-mixed-kinds","query":"#[1 \"a\"] | union #[null 2]","expect":"#[null 1 2 \"a\"]"}
{"name":"minus-merges-two-sets","query":"#[1 2 3 4] | minus #[0 2 4 6]","expect":"#[1 3]"}
{"name":"inter-merges-two-sets","query":"#[1 2 3 4] | inter #[0 2 4 6]","expect":"#[2 4]"}
{"name":"a-vector-is-no-set-for-the-algebra","query":"[1] | union #[2] !| type","expect":"::UnionPairIncompatibleError"}
{"name":"the-bare-form-folds-a-set-of-sets","query":"#[#[1] #[2]] | union","expect":"#[1 2]"}
{"name":"keys-answer-the-one-order","query":"{:b 1 :a 2} | keys | payload","expect":"[:a :b]"}
{"name":"two-sets-are-equal-by-their-content","query":"#[1 2] | eq #[2 1]","expect":"true"}
{"name":"a-set-is-not-its-vector","query":"#[1 2] | eq [1 2]","expect":"false"}
{"name":"groupBy-over-a-set-answers-set-buckets","query":"#[{:k :b :v 2} {:k :a :v 1} {:k :b :v 1}] | groupBy ~(/k) | /b","expect":"#[{:k :b :v 1} {:k :b :v 2}]"}
{"name":"first-of-an-empty-set-is-null","query":"#[] | first","expect":"null"}
