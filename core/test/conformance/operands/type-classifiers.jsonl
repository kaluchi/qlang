{"name":"type-string","query":"\"hello\" | type","expect":":string"}
{"name":"type-empty-string","query":"\"\" | type","expect":":string"}
{"name":"type-number-integer","query":"42 | type","expect":":number"}
{"name":"type-number-decimal","query":"3.14 | type","expect":":number"}
{"name":"type-number-negative","query":"-7 | type","expect":":number"}
{"name":"type-number-zero","query":"0 | type","expect":":number"}
{"name":"type-vec","query":"[1 2 3] | type","expect":":vec"}
{"name":"type-vec-empty","query":"[] | type","expect":":vec"}
{"name":"type-map","query":"{:a 1} | type","expect":":map"}
{"name":"type-map-empty","query":"{} | type","expect":":map"}
{"name":"type-set","query":"#[1 2] | type","expect":":set"}
{"name":"type-set-empty","query":"#[] | type","expect":":set"}
{"name":"type-keyword","query":":name | type","expect":":keyword"}
{"name":"type-tag-keyword","query":"::Foo | type","expect":":tagKeyword"}
{"name":"type-boolean-true","query":"true | type","expect":":boolean"}
{"name":"type-boolean-false","query":"false | type","expect":":boolean"}
{"name":"type-null","query":"null | type","expect":":null"}
{"name":"type-quote","query":"~{mul(2)} | type","expect":":quote"}
{"name":"type-doc","query":"|~~ note ~~| | type","expect":":doc"}
{"name":"type-json-object","query":"::json{:k 1} | type","expect":":jsonObject"}
{"name":"type-json-array","query":"::json[1 2] | type","expect":":jsonArray"}
{"name":"type-conduit-is-not-map","query":":double mul(2) | env | /double | type | eq(:map)","expect":"false"}
{"name":"classify-in-filter-over-map-string","query":"{:a 1 :b \"x\" :c [1]} | filter(type | eq(:string))","expect":"{:b \"x\"}"}
{"name":"classify-in-filter-over-map-map","query":"{:a 1 :b {:x 1}} | filter(type | eq(:map))","expect":"{:b {:x 1}}"}
{"name":"classify-in-filter-over-map-vec","query":"{:a 1 :b [1 2]} | filter(type | eq(:vec))","expect":"{:b [1 2]}"}
