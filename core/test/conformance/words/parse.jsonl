{"name":"parse-keyword-literal-step","query":"\":foo\" | parse | first","expect":":foo"}
{"name":"parse-call-name","query":"\"add 1 2\" | parse | first | /name","expect":":add"}
{"name":"parse-call-modifiers-count","query":"\"add 1 2\" | parse | first | /modifiers | count","expect":"2"}
