{
  "name": "@kaluchi/qlang-playground",
  "version": "0.10.0",
  "description": "qplay — a demo command-line app for playing with qlang and checking that its core answers: vanilla qlang-core + qlang-stdio, queried from the shell or in its REPL; the smallest host that embeds the language.",
  "type": "module",
  "bin": {
    "qplay": "src/bin.mjs"
  },
  "files": [
    "src/",
    "lib/"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "qlang",
    "playground",
    "repl",
    "query-language"
  ],
  "license": "Apache-2.0",
  "author": "kaluchi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaluchi/qlang.git"
  },
  "dependencies": {
    "@kaluchi/qlang-core": "^0.10.0",
    "@kaluchi/qlang-stdio": "^0.10.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "vitest": "^5.0.0"
  }
}
