els) | flat | map ~(/name) | map ~(lower) | distinct | sort\nT6: / | sort ~([(/comments | desc) /number]) | take 3 | map ~({:number /number :assignee ((/assignee | /login) !| null)})\nT7: / | filter ~(/state | eq \"open\") | filter ~(/assignee | ne null) | groupBy ~(/assignee/login) | map ~(count)\nT8: :root / | /dependencies | union (:root | /devDependencies) | entries | filter ~(/1 | startsWith \"^\") | map ~(:e / | /0 | append \"@\" | append (:e | /1)) | sort\nT9: /services | filter ~(allOf (/enabled | coalesce false) (/port | gt 8000)) | map ~(/name) | map ~(lower) | sort | join \",\"\nT10: / | split \"\\n\" | filter ~(ne \"\") | map ~(split \" \") | filter ~(/1 | eq \"ERROR\") | map ~(/2) | groupBy ~(/) | map ~(count)\nT11: / | split \"\\n\" | filter ~(contains \"ms=\") | map ~(split \"ms=\" | /1 | split \" \" | /0 | parseJson) | avg | round 1\nT12: / | split \"\\n\" | drop 1 | filter ~(ne \"\") | map ~(split \",\") | filter ~(allOf (/5 | lower | eq \"shipped\") (/4 | ne \"\")) | map ~(:qty (/3 | parseJson) | :price (/4 | parseJson) | :qty / | mul :price /) | sum | round 2\nT13: / | split \"\\n\" | drop 1 | filter ~(ne \"\") | map ~(split \",\") | filter ~(allOf (/5 | lower | ne \"cancelled\") (/4 | ne \"\")) | groupBy ~(/1) | entries | map ~({:customer /0 :total (/1 | map ~((:q (/3 | parseJson) | :p (/4 | parseJson) | :q / | mul :p /)) | sum | round 2)}) | sort ~((/total | desc)) | take 2\nT14: [\"Banana\",\"apple\",\"Cherry\",\"banana\",\"fig\",\"APPLE\",\"date\",\"kiwi\",\"Fig\",\"elderberry\"] | map ~(lower) | distinct | sort ~([(/count | desc) /]) | join \"-\"",
