{
  "wordPattern": { "pattern": "[_\\p{L}][\\p{L}\\p{N}_-]*|[0-9]+(?:\\.[0-9]+)?", "flags": "u" },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "[\\[{(][^\\]})]*$",
    "decreaseIndentPattern": "^\\s*[\\]})][,]?\\s*$"
  },
  "folding": {
    "markers": {
      "start": { "pattern": "^:(?=[_\\p{L}])", "flags": "u" },
      "end": "^(?!)"
    }
  }
}
