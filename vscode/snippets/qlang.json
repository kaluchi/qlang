{
  "declare a name": {
    "prefix": "bind",
    "body": [":${1:name} ${2:body}"],
    "description": "Name what the body answers, for the steps after it"
  },
  "declare a word": {
    "prefix": "bindv",
    "body": [":${1:vec}/${2:name}", "  |~~ ${3:What it answers.} ~~|", "  ::fn", "    | takes :${4:input} |~~ ${5:What it takes.} ~~| /0", "    | impl ~(${6:recipe})"],
    "description": "Declare a word under the label of its subject, the chain of its function"
  },
  "declare a kind": {
    "prefix": "bindtag",
    "body": [":${1:Kind}", "  |~~ ${2:What its values are.} ~~|", "  ::kind", "    | reads :${3:field} |~~ ${4:What it holds.} ~~| /${3:field}"],
    "description": "Declare a kind by its page and the chain of its commands"
  },
  "name the subject": {
    "prefix": "name",
    "body": [":${1:name} it"],
    "description": "Name the value in the pipe for the steps after it"
  },
  "filter": {
    "prefix": "filter",
    "body": ["filter ~(${1:predicate})"],
    "description": "Keep elements matching predicate"
  },
  "map literal": {
    "prefix": "map",
    "body": ["{:${1:key} ${2:value}}"],
    "description": "Map literal"
  },
  "vec literal": {
    "prefix": "vec",
    "body": ["[${1:elements}]"],
    "description": "Vec literal"
  },
  "set literal": {
    "prefix": "set",
    "body": ["#[${1:elements}]"],
    "description": "Set literal — the vector in the one order without duplicates"
  },
  "if": {
    "prefix": "if",
    "body": ["if (${1:cond}) ~(${2:then}) ~(${3:else})"],
    "description": "Conditional — only selected branch executes"
  },
  "cond": {
    "prefix": "cond",
    "body": ["cond ~(${1:pred1}) ~(${2:val1}) ~(${3:pred2}) ~(${4:val2})"],
    "description": "Multi-way dispatch over predicate/branch pairs"
  },
  "groupBy": {
    "prefix": "groupBy",
    "body": ["groupBy ${1:/field}"],
    "description": "Partition Vec into Map keyed by classifier"
  },
  "indexBy": {
    "prefix": "indexBy",
    "body": ["indexBy ${1:/field}"],
    "description": "Collapse Vec into Map, last-wins on collision"
  },
  "line plain comment": {
    "prefix": "|~|",
    "body": ["|~| ${1:comment}"],
    "description": "Line comment, which no step reads"
  },
  "block plain comment": {
    "prefix": "|~",
    "body": ["|~ ${1:comment} ~|"],
    "description": "Block comment, which no step reads"
  },
  "line doc comment": {
    "prefix": "|~~|",
    "body": ["|~~| ${1:doc}"],
    "description": "Line doc, the page of the name before it or a value of its own"
  },
  "block doc comment": {
    "prefix": "|~~",
    "body": ["|~~ ${1:doc} ~~|"],
    "description": "Block doc, the page of the name before it or a value of its own"
  },
  "coalesce": {
    "prefix": "coalesce",
    "body": ["coalesce ~(${1:alt1}) ~(${2:alt2}) ~(${3:default})"],
    "description": "First non-null result among alternatives"
  },
  "sort by key": {
    "prefix": "sortk",
    "body": ["sort ${1:/field}"],
    "description": "Sort by key sub-pipeline"
  },
  "union bound": {
    "prefix": "unionb",
    "body": ["union {${1::key ${2:expr}}}"],
    "description": "Enrich Map via bound union"
  },
  "minus bound": {
    "prefix": "minusb",
    "body": ["minus #[${1::key}]"],
    "description": "Drop fields via bound minus"
  },
  "inter bound": {
    "prefix": "interb",
    "body": ["inter #[${1::key}]"],
    "description": "Select fields via bound inter"
  }
}
