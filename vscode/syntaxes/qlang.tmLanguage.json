{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "qlang",
  "scopeName": "source.qlang",
  "fileTypes": ["qlang"],
  "patterns": [
    { "include": "#doc-line" },
    { "include": "#doc-block" },
    { "include": "#comment-line" },
    { "include": "#comment-block" },
    { "include": "#regex" },
    { "include": "#string" }
  ],
  "repository": {
    "doc-line": {
      "name": "comment.line.documentation.qlang",
      "begin": "\\|~~\\|",
      "end": "$"
    },
    "doc-block": {
      "name": "comment.block.documentation.qlang",
      "begin": "\\|~~(?!\\|)",
      "end": "~~\\|",
      "patterns": [
        { "include": "#backquoted" },
        { "include": "#quote" },
        { "include": "#doc-block" }
      ]
    },
    "backquoted": {
      "match": "(`+)(?:(?!~~\\|).)*?(?<!`)\\1(?!`)"
    },
    "quote": {
      "begin": "~\\(",
      "end": "\\)",
      "patterns": [
        { "include": "#parenthesized" },
        { "include": "$self" }
      ]
    },
    "parenthesized": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        { "include": "#parenthesized" },
        { "include": "$self" }
      ]
    },
    "comment-line": {
      "name": "comment.line.qlang",
      "match": "\\|~\\|.*$"
    },
    "comment-block": {
      "name": "comment.block.qlang",
      "begin": "\\|~(?![|~])",
      "end": "~\\|",
      "patterns": [{ "include": "#comment-block" }]
    },
    "regex": {
      "name": "string.regexp.qlang",
      "begin": "#\"",
      "end": "\"[a-zA-Z]*",
      "patterns": [{ "match": "\\\\." }]
    },
    "string": {
      "name": "string.quoted.double.qlang",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.qlang", "match": "\\\\." }]
    }
  }
}
